          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"gridPeakIdx", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"Length", "[", "gridU", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rightRoot", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"MissingQ", "[", "rightBracket", "]"}]}], ",", 
           RowBox[{"Quiet", "@", 
