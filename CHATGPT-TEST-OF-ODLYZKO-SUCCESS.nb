      RowBox[{"N", "[", 
       RowBox[{"Tconv", ",", "8"}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "=="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"PHASE", " ", "1"}], ":", 
     RowBox[{"DISCOVER", " ", "CANDIDATES", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"fixed", " ", "full"}], "-", 
