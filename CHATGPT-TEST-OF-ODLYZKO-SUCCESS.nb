   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LoadData", "[", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zerosImported", ",", "alphasImported", ",", "count", ",", "pairs"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<\\n=== LOADING DATA ===\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<Parsing zero ordinates...\>\"", "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"zerosImported", "=", 
         RowBox[{"ImportHighPrec", "[", "zeroFile", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"zerosImported", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<Parsing amplitudes...\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"alphasImported", "=", 
         RowBox[{"ImportHighPrec", "[", "alphaFile", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"alphasImported", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"count", "=", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Length", "[", "zerosImported", "]"}], ",", 
           RowBox[{"Length", "[", "alphasImported", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zerosImported", "=", 
         RowBox[{"zerosImported", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "count"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"alphasImported", "=", 
         RowBox[{"alphasImported", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "count"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"!", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{"NumericQ", "/@", "zerosImported"}], ")"}]}]}], "||", 
           RowBox[{"!", 
            RowBox[{"And", "@@", 
             RowBox[{"(", 
              RowBox[{"NumericQ", "/@", "alphasImported"}], ")"}]}]}]}], ",", 
          
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<ERROR: Nonnumeric imported data.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"OrderedQ", "[", "zerosImported", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Zero ordinates are not sorted. \>\"", ",", 
             "\"\<Sorting synchronized pairs...\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"pairs", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{"zerosImported", ",", "alphasImported"}], "}"}], 
