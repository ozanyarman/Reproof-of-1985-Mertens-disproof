             "\"\< | original zero index \>\"", ",", "ambientIndex"}], "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"augmentedZeros", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"selectedZeros", ",", 
              RowBox[{"zeros", "[", 
               RowBox[{"[", "ambientIndex", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"audit", "=", 
            RowBox[{"ScalingAudit", "[", 
             RowBox[{"augmentedZeros", ",", "scale"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"TrueQ", "[", 
               RowBox[{"audit", "[", "\"\<Stable\>\"", "]"}], "]"}]}], ",", 
