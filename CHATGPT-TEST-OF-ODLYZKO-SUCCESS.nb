             RowBox[{"-", "500"}], ",", "500"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"valsCoarse", "=", 
         RowBox[{"evalU", "/@", "gridCoarse"}]}], ";", 
        RowBox[{"idxCoarse", "=", 
