          RowBox[{"rows", ".", "QR"}], " ", "must", " ", "therefore", " ", 
          "be", " ", "applied", " ", "to", " ", 
          RowBox[{"Transpose", "[", "basis", "]"}]}], ",", 
         RowBox[{
         "whose", " ", "columns", " ", "are", " ", "the", " ", "basis", " ", 
