Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "MASTER", "-", "MERTENS", "-", "Wavepacket", "-", "Fingerprint", "-", 
    RowBox[{"Scanner", " ", 
     RowBox[{"(", 
      RowBox[{"Corrected", " ", "v4"}], ")"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"CHANGES", " ", "vs", " ", 
      RowBox[{"v3", ":", 
       RowBox[{"-", "scaleKernelWithNMax"}]}]}], "=", 
     RowBox[{
      RowBox[{"False", "->", 
       RowBox[{"fixed", "-", 
        RowBox[{"window", " ", "TRUE", " ", "convergence", " ", "study"}], 
        "-", "Tconv"}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"zeros", "[", 
          RowBox[{"[", "availableTerms", "]"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"full", " ", "100000", " ", "window"}], ")"}], " ", "for", 
         " ", "discovery"}], "+", 
        RowBox[{"Phase", " ", "2"}], "-", "Tbench"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"zeros", "[", 
          RowBox[{"[", "2000", "]"}], "]"}], " ", "kept", " ", "SEPARATE", 
         " ", "and", " ", "UNCHANGED", " ", "for", " ", "OtR", " ", 
         "calibration"}], "-", 
        RowBox[{
        "nMaxValues", " ", "extended", " ", "to", " ", "50000"}]}]}]}]}], ",", 
    RowBox[{
     RowBox[{"100000", "-", 
      RowBox[{"NEW", " ", "Phase", " ", "3"}]}], ":", 
     RowBox[{
      RowBox[{"automatic", " ", "random"}], "-", 
      RowBox[{
      "control", " ", "test", " ", "on", " ", "the", " ", "best", " ", 
       "candidate"}], "-", "NEW"}], ":", 
     RowBox[{
      RowBox[{
       RowBox[{"Dataset", "/", "Grid"}], "/", "CSV"}], " ", "export", " ", 
      "block"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "SetDirectory", "[", 
     "\"\</Users/ozanyarman/Documents/Wolfram Mathematica/\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"$MaxExtraPrecision", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"workingPrecision", "=", "250"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"scaleKernelWithNMax", "=", "False"}], ";", 
    RowBox[{"(*", 
     RowBox[{"False", "=", 
      RowBox[{
       RowBox[{"fixed", " ", "OtR", " ", "window"}], "=", 
       RowBox[{">", 
        RowBox[{"real", " ", "convergence"}]}]}]}], "*)"}], 
    RowBox[{"nControls", "=", "20"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"number", " ", "of", " ", "random"}], "-", 
      RowBox[{"control", " ", "coordinates"}]}], "*)"}], 
    RowBox[{
    "Print", "[", "\"\<=== 1. LOADING DATA & BENCHMARK ===\>\"", "]"}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ImportHighPrec", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ImportHighPrec", "[", "fileName_String", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rawText", ",", "tokens"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"FileExistsQ", "[", "fileName", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<ERROR: File not found: \>\"", ",", "fileName"}], 
            "]"}], ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"rawText", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"fileName", ",", "\"\<String\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tokens", "=", 
         RowBox[{"StringSplit", "[", 
          RowBox[{
           RowBox[{"StringTrim", "[", "rawText", "]"}], ",", 
           RowBox[{"RegularExpression", "[", "\"\<[\\\\s,]+\>\"", "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tokens", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"tokens", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"StringLength", "[", "#", "]"}], ">", "0"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ToExpression", "[", 
            RowBox[{"#", "<>", "\"\<`\>\"", "<>", 
             RowBox[{"ToString", "[", "workingPrecision", "]"}]}], "]"}], 
           "&"}], ",", "tokens"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Parsing zeros...\>\"", "]"}], ";", 
    RowBox[{"zerosAll", "=", 
     RowBox[{"ImportHighPrec", "[", "\"\<high_prec_zeros.txt\>\"", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Parsing amplitudes...\>\"", "]"}], ";", 
    RowBox[{"alphasAll", "=", 
     RowBox[{"ImportHighPrec", "[", "\"\<high_prec_alpha.txt\>\"", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Parsing phases...\>\"", "]"}], ";", 
    RowBox[{"psiAll", "=", 
     RowBox[{"ImportHighPrec", "[", "\"\<high_prec_arg.txt\>\"", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"availableTerms", "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Length", "[", "zerosAll", "]"}], ",", 
       RowBox[{"Length", "[", "alphasAll", "]"}], ",", 
       RowBox[{"Length", "[", "psiAll", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"availableTerms", "<", "2000"}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<ERROR: >= 2000 synchronized entries required.\>\"", 
        "]"}], ";", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"zeros", "=", 
     RowBox[{"zerosAll", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "availableTerms"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphas", "=", 
     RowBox[{"alphasAll", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "availableTerms"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psi", "=", 
     RowBox[{"psiAll", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "availableTerms"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Synchronized terms available: \>\"", ",", "availableTerms"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", "PRECISION"}]}], " ", 
     RowBox[{
      RowBox[{"INFRASTRUCTURE", "--"}], "--"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"inputPrecision", "=", "workingPrecision"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"safetyDigits", "=", "25"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaMax", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"zeros", "[", 
       RowBox[{"[", 
        RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"survivingDigits", "[", "y_", "]"}], ":=", 
     RowBox[{"inputPrecision", "-", 
      RowBox[{"Ceiling", "[", 
       RowBox[{"Log10", "[", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"gammaMax", "*", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", 
             RowBox[{"y", ",", "30"}], "]"}], "]"}]}], ",", "10"}], "]"}], 
        "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"neededPrec", "[", "y_", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"60", ",", 
       RowBox[{
        RowBox[{"Ceiling", "[", 
         RowBox[{"Log10", "[", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"gammaMax", "*", 
             RowBox[{"Abs", "[", 
              RowBox[{"N", "[", 
               RowBox[{"y", ",", "30"}], "]"}], "]"}]}], ",", "10"}], "]"}], 
          "]"}], "]"}], "+", "40"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"trustworthyQ", "[", "y_", "]"}], ":=", 
     RowBox[{
      RowBox[{"survivingDigits", "[", "y", "]"}], ">=", "safetyDigits"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"safePrec", "[", "y_", "]"}], ":=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"neededPrec", "[", "y", "]"}], ",", "inputPrecision"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", "TWO"}]}], " ", "SEPARATE", " ", 
     RowBox[{
      RowBox[{"WINDOWS", "--"}], "--"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Tbench", "=", 
     RowBox[{"zeros", "[", 
      RowBox[{"[", "2000", "]"}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"OtR", " ", "calibration", " ", "window"}], "-", 
      RowBox[{"DO", " ", "NOT", " ", "CHANGE"}]}], "*)"}], 
    RowBox[{"Tconv", "=", 
     RowBox[{"zeros", "[", 
      RowBox[{"[", "availableTerms", "]"}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"fixed", " ", "convergence", " ", "window", " ", 
      RowBox[{"(", 
       RowBox[{"full", " ", "100000"}], ")"}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", "Odlyzko"}]}], "-", 
      RowBox[{"te", " ", "Riele", " ", "1985", " ", "benchmark", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"uses", " ", "Tbench", " ", "ONLY"}], ")"}], "--"}], 
        "--"}]}]}], "*)"}], 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "t", "]"}], "<=", "1"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"Abs", "[", "t", "]"}]}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"Pi", " ", "t"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"Pi", " ", 
           RowBox[{"Abs", "[", "t", "]"}]}], "]"}], "/", "Pi"}]}], ",", "0"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"T1985", "=", "Tbench"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kernelWeights", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"g", "/@", 
        RowBox[{"(", 
         RowBox[{"zeros", "/", "T1985"}], ")"}]}], ",", "inputPrecision"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"weightedAmplitudes", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"kernelWeights", "*", "alphas"}], ",", "inputPrecision"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"h1985", "[", 
      RowBox[{"y_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", "=", 
         RowBox[{"safePrec", "[", "y", "]"}]}], "}"}], ",", 
       RowBox[{"2", " ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"SetPrecision", "[", 
           RowBox[{"weightedAmplitudes", ",", "p"}], "]"}], "*", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"SetPrecision", "[", 
              RowBox[{"zeros", ",", "p"}], "]"}], "*", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"y", ",", "p"}], "]"}]}], "-", 
            RowBox[{"SetPrecision", "[", 
             RowBox[{"psi", ",", "p"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"yPositiveExact", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
         "14045289680592998046790361630399781127400591999789738039965960762", 
          "*", 
          RowBox[{"10", "^", "6"}]}], "+", "521505"}], ")"}]}], "/", 
      RowBox[{"10", "^", "6"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"positiveResult", "=", 
     RowBox[{"h1985", "[", "yPositiveExact", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
