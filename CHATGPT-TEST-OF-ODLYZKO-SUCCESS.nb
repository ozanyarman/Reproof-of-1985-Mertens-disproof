===\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"findAdjacentTrough", "[", 
      RowBox[{"grid_", ",", "values_", ",", "peakIdx_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"leftIdx", ",", "rightIdx", ",", "i", ",", "m"}], "}"}], ",", 
       
       RowBox[{
        RowBox[{"m", "=", 
         RowBox[{"Length", "[", "values", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"leftIdx", "=", "peakIdx"}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", 
           RowBox[{"peakIdx", "-", "1"}]}], ",", 
          RowBox[{"i", ">=", "2"}], ",", 
          RowBox[{"i", "--"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<=", 
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "&&", 
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<=", 
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"leftIdx", "=", "i"}], ";", 
             RowBox[{"Break", "[", "]"}]}]}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightIdx", "=", "peakIdx"}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", 
           RowBox[{"peakIdx", "+", "1"}]}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"m", "-", "1"}]}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<=", 
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "&&", 
