                  RowBox[{"Pi", "*", "t"}], "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", "Pi"}], ")"}], "*", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"Pi", "*", "t"}], "]"}]}]}], ",", "0"}], "]"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "nMaxCurrent"}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"zc", ",", "pc", ",", "ac", ",", "kk"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"evaluateCandidate", "[", 
      RowBox[{"cand_", ",", "kernelData_", ",", "nMaxCurrent_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zc", ",", "pc", ",", "ac", ",", "kk", ",", "prec", ",", "zH", ",", 
         "pH", ",", "aH", ",", "kH", ",", "wgt", ",", "base", ",", "absY", 
         ",", "evalU", ",", "gridCoarse", ",", "valsCoarse", ",", "idxCoarse",
          ",", "gridFine", ",", "valsFine", ",", "idxFine", ",", "gridUltra", 
