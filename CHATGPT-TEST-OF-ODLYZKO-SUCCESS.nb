   RowBox[{
    RowBox[{"ClearAll", "[", "RunAmbientPilot", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunAmbientPilot", "[", 
      RowBox[{
      "zeros_List", ",", "candidate_Association", ",", 
       "baseResult_Association"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "selectedZeros", ",", "selectedN", ",", "ambientIndices", ",", 
         "requiredN", ",", "rawSum", ",", "kDigits", ",", "scale", ",", 
         "threshold", ",", "startPosition", ",", "records", ",", 
         "minimumCertifiedN", ",", "i", ",", "ambientIndex", ",", 
         "augmentedZeros", ",", "audit", ",", "basis", ",", "reduced", ",", 
         "timing", ",", "qrAudit", ",", "gsMinimum", ",", "certifiedN", ",", 
         "passed", ",", "finalBound", ",", "status", ",", "result"}], "}"}], 
       ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"baseResult", "[", "\"\<Status\>\"", "]"}], "=!=", 
           "\"\<BasePassed\>\""}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<AMBIENT PILOT WILL NOT RUN: \>\"", ",", 
             "\"\<the base condition did not pass.\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"<|", 
             RowBox[{"\"\<Status\>\"", "->", "\"\<BaseDidNotPass\>\""}], 
             "|>"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"selectedZeros", "=", 
         RowBox[{"candidate", "[", "\"\<SelectedZeros\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedN", "=", 
         RowBox[{"candidate", "[", "\"\<SelectedN\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ambientIndices", "=", 
         RowBox[{"candidate", "[", "\"\<AmbientIndices\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"requiredN", "=", 
         RowBox[{"candidate", "[", "\"\<RequiredN\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rawSum", "=", 
         RowBox[{"candidate", "[", "\"\<RawSum\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kDigits", "=", 
         RowBox[{"baseResult", "[", "\"\<KDigits\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scale", "=", 
         RowBox[{"baseResult", "[", "\"\<Scale\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"threshold", "=", 
         RowBox[{"AugmentedThreshold", "[", 
          RowBox[{"selectedN", ",", "requiredN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<\\n============================================================\
\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\< FULL AMBIENT NUMERICAL PILOT\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<============================================================\>\"\
", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Ambient tests required: \>\"", ",", 
          RowBox[{"Length", "[", "ambientIndices", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Requested augmented threshold: \>\"", ",", "threshold"}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", "checkpointFile", "]"}], ",", 
          RowBox[{
           RowBox[{"checkpoint", "=", 
            RowBox[{"Import", "[", "checkpointFile", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"startPosition", "=", 
            RowBox[{"checkpoint", "[", "\"\<NextPosition\>\"", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"records", "=", 
            RowBox[{"checkpoint", "[", "\"\<Records\>\"", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"minimumCertifiedN", "=", 
            RowBox[{"checkpoint", "[", "\"\<MinimumCertifiedN\>\"", "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Resuming from ambient test \>\"", ",", "startPosition"}], 
            "]"}]}], ",", 
          RowBox[{
           RowBox[{"startPosition", "=", "1"}], ";", "\[IndentingNewLine]", 
           RowBox[{"records", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"minimumCertifiedN", "=", 
            RowBox[{"baseResult", "[", "\"\<CertifiedN\>\"", "]"}]}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"status", "=", "\"\<Running\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
