   RowBox[{
    RowBox[{"ClearAll", "[", "scanCutoff", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"scanCutoff", "[", 
      RowBox[{"L_Integer", ",", "maximumSelected_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "T", ",", "localZeros", ",", "localAlphas", ",", "kernelWeights", ",",
          "contributions", ",", "ranking", ",", "sortedContributions", ",", 
