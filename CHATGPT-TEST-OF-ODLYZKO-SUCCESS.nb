         RowBox[{"Diagonal", "[", "r", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Abs", "[", "diagonal", "]"}], "^", "2"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "StableQRAudit", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"StableQRAudit", "[", 
      RowBox[{"basis_List", ",", "latticeDigits_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "precisions", ",", "results", ",", "minima", ",", 
         "relativeDifferences", ",", "stable", ",", "i"}], "}"}], ",", 
       RowBox[{
        RowBox[{"precisions", "=", 
         RowBox[{"latticeDigits", "+", "qrExtraPrecisions"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "precisions", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Computing QR Gram-Schmidt at \>\"", ",", 
             RowBox[{"precisions", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\"\< digits...\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"results", ",", 
             RowBox[{"QRGSNormsSquared", "[", 
              RowBox[{"basis", ",", 
               RowBox[{"precisions", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<  Minimum squared norm = \>\"", ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"Min", "[", 
                RowBox[{"results", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}], "]"}], ",", "30"}], 
              "]"}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"minima", "=", 
         RowBox[{"Min", "/@", "results"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"relativeDifferences", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"minima", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"minima", "[", 
               RowBox[{"[", 
                RowBox[{"i", "-", "1"}], "]"}], "]"}]}], "]"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", 
              RowBox[{"Abs", "[", 
               RowBox[{"minima", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", 
             RowBox[{"Length", "[", "minima", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Relative differences between precision levels: \>\"", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"ScientificForm", "[", 
             RowBox[{"#", ",", "8"}], "]"}], "&"}], "/@", 
           RowBox[{"N", "[", 
            RowBox[{"relativeDifferences", ",", "12"}], "]"}]}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"stable", "=", 
         RowBox[{
          RowBox[{"Last", "[", "relativeDifferences", "]"}], "<", 
          "qrStabilityTolerance"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Precisions\>\"", "->", "precisions"}], ",", 
          RowBox[{"\"\<Minima\>\"", "->", "minima"}], ",", 
          RowBox[{"\"\<FinalNormsSquared\>\"", "->", 
           RowBox[{"Last", "[", "results", "]"}]}], ",", 
          RowBox[{"\"\<FinalMinimumSquared\>\"", "->", 
           RowBox[{"Last", "[", "minima", "]"}]}], ",", 
          RowBox[{
          "\"\<RelativeDifferences\>\"", "->", "relativeDifferences"}], ",", 
          RowBox[{"\"\<Stable\>\"", "->", "stable"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
