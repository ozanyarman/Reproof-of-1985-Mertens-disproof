Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"PHASE", " ", "5", 
    RowBox[{"A", ":", 
     RowBox[{
      RowBox[{"FAST", " ", "ODLYZKO"}], "-", 
      RowBox[{"PEAK", " ", "HARVESTER", " ", 
       RowBox[{"(", 
        RowBox[{"PRODUCTION", " ", "READY"}], ")"}]}]}]}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n=== PHASE 5A: MACROSCOPIC STATISTICAL HARVEST ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "1.", " ", "Gather", " ", "all", " ", "candidates", " ", "from", " ", 
      "the", " ", "pipeline"}], ",", 
     RowBox[{"maximize", " ", "quantity"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allCandidates", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"finalResults", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<pipeline\>\"", "]"}], "==", "\"\<g0\>\""}], 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nTotal", "=", 
     RowBox[{"Length", "[", "allCandidates", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Harvesting features for \>\"", ",", "nTotal", ",", 
      "\"\< candidate exceedances...\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Ensure", " ", "Kernel", " ", "Data", " ", "is", " ", "loaded",
      " ", "for", " ", "the", " ", "maximum", " ", "nVal"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxNVal", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"allCandidates", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "\"\<sampleSize\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zc4", ",", "pc4", ",", "ac4", ",", "kk4"}], "}"}], "=", 
     RowBox[{"buildKernelData", "[", "maxNVal", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Precompute", " ", "global", " ", "weights", " ", "and", " ", "maximum", 
     " ", "theoretical", " ", "amplitude"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"weights", "=", 
     RowBox[{"kk4", "*", "ac4"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxPossibleAmplitude", "=", 
     RowBox[{"2", "*", 
      RowBox[{"Total", "[", "weights", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Fast", " ", "Feature", " ", "Extraction", " ", "Engine", " ", 
     
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Strictly", " ", "Observables"}], ",", 
       RowBox[{"No", " ", "Assumptions"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"harvestData", "=", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "vVal", ",", "baseX", ",", "pY", ",", "sSize", ",", "pipe", ",", 
             "prec", ",", "zH", ",", "pH", ",", "wgt", ",", "phi0", ",", "A", 
             ",", "D2", ",", "D4", ",", "Anorm", ",", "contribs", ",", 
             "top5Idx"}], "}"}], ",", 
           RowBox[{"(*", 
            RowBox[{"State", " ", "Variables"}], "*)"}], 
           RowBox[{
            RowBox[{"vVal", "=", 
             RowBox[{"cand", "[", "\"\<v\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"baseX", "=", 
             RowBox[{"cand", "[", "\"\<peakX\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pY", "=", 
             RowBox[{"cand", "[", "\"\<peakY\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"sSize", "=", 
             RowBox[{"cand", "[", "\"\<sampleSize\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pipe", "=", 
             RowBox[{"cand", "[", "\"\<pipeline\>\"", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"prec", "=", 
             RowBox[{"safePrec", "[", "baseX", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"zH", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"zc4", ",", "prec"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pH", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"pc4", ",", "prec"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"wgt", "=", 
             RowBox[{"SetPrecision", "[", 
              RowBox[{"weights", ",", "prec"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Base", " ", "Phase"}], "*)"}], 
            RowBox[{"phi0", "=", 
             RowBox[{
              RowBox[{"zH", "*", 
               RowBox[{"SetPrecision", "[", 
                RowBox[{"baseX", ",", "prec"}], "]"}]}], "-", "pH"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"--", 
                RowBox[{"-", "FAST"}]}], " ", 
               RowBox[{"OBSERVABLES", "--"}]}], "-"}], "*)"}], 
            RowBox[{"(*", 
             RowBox[{"Absolute", " ", "Amplitude", " ", "F", 
              RowBox[{"(", "x0", ")"}]}], "*)"}], 
            RowBox[{"A", "=", 
             RowBox[{"2", "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"Cos", "[", "phi0", "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Normalized", " ", "Amplitude", " ", 
              RowBox[{"(", 
               RowBox[{"A", "/", "A_max"}], ")"}]}], "*)"}], 
            RowBox[{"Anorm", "=", 
             RowBox[{"A", "/", "maxPossibleAmplitude"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Local", " ", "Curvature", " ", 
              RowBox[{"(", 
               RowBox[{"Second", " ", "Derivative", " ", 
                RowBox[{"F", "''"}], 
                RowBox[{"(", "x0", ")"}]}], ")"}]}], "*)"}], 
            RowBox[{"D2", "=", 
             RowBox[{
              RowBox[{"-", "2"}], "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"zH", "^", "2"}], "*", 
                RowBox[{"Cos", "[", "phi0", "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Fourth", " ", "Derivative", " ", 
              RowBox[{"F", "''''"}], 
              RowBox[{"(", "x0", ")"}]}], "*)"}], 
            RowBox[{"D4", "=", 
             RowBox[{"2", "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"zH", "^", "4"}], "*", 
                RowBox[{"Cos", "[", "phi0", "]"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Top", " ", "5", " ", "Dominant", " ", "Modes", " ", 
              RowBox[{"(", 
               RowBox[{
               "Sorted", " ", "Largest", " ", "to", " ", "Smallest", " ", 
                "Contributor"}], ")"}]}], "*)"}], 
            RowBox[{"contribs", "=", 
             RowBox[{"2", "*", "wgt", "*", 
              RowBox[{"Cos", "[", "phi0", "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"top5Idx", "=", 
             RowBox[{"Reverse", "[", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"Abs", "[", "contribs", "]"}], ",", 
                RowBox[{"-", "5"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<v\>\"", "->", "vVal"}], ",", 
              RowBox[{"\"\<sampleSize\>\"", "->", "sSize"}], ",", 
              RowBox[{"\"\<pipeline\>\"", "->", "pipe"}], ",", 
              RowBox[{"\"\<peakX\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"baseX", ",", "12"}], "]"}]}], ",", 
              RowBox[{"\"\<peakY\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"pY", ",", "8"}], "]"}]}], ",", 
              RowBox[{"\"\<Amplitude\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"A", ",", "8"}], "]"}]}], ",", 
              RowBox[{"\"\<NormAmplitude\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"Anorm", ",", "8"}], "]"}]}], ",", 
              RowBox[{"\"\<CurvatureD2\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"D2", ",", "8"}], "]"}]}], ",", 
              RowBox[{"\"\<FourthDerivD4\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"D4", ",", "8"}], "]"}]}], ",", 
              RowBox[{"\"\<TopMode1\>\"", "->", 
               RowBox[{"top5Idx", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<TopMode2\>\"", "->", 
               RowBox[{"top5Idx", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<TopMode3\>\"", "->", 
               RowBox[{"top5Idx", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<TopMode4\>\"", "->", 
               RowBox[{"top5Idx", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<TopMode5\>\"", "->", 
               RowBox[{"top5Idx", "[", 
                RowBox[{"[", "5", "]"}], "]"}]}]}], "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"cand", ",", "allCandidates"}], "}"}]}], "]"}], ",", 
       RowBox[{"ProgressIndicator", "[", 
        RowBox[{
         RowBox[{"Dynamic", "[", "cand", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "nTotal"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Structure", " ", "and", " ", "Export"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"harvestDataset", "=", 
     RowBox[{"Dataset", "[", "harvestData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exportPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<Phase5A_Harvest.csv\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"exportPath", ",", "harvestData", ",", "\"\<CSV\>\""}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<\\nHarvest Complete! Extracted \>\"", ",", "nTotal", ",", 
      "\"\< records.\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Data exported for Phase 5B to: \>\"", ",", "exportPath"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Preview", " ", "the", " ", "first", " ", "10", " ", "records"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nPreview of Statistical Harvest:\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"harvestDataset", "[", 
      RowBox[{"1", ";;", 
       RowBox[{"Min", "[", 
        RowBox[{"10", ",", "nTotal"}], "]"}]}], "]"}], "]"}], 
    ";"}]}]}]], "Input",
