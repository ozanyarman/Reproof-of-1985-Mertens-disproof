         RowBox[{"baselineCurrent", "-", 
          RowBox[{"cand", "[", "\"\<baselineDiscovery\>\"", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<v\>\"", "->", 
           RowBox[{"cand", "[", "\"\<v\>\"", "]"}]}], ",", 
          RowBox[{"\"\<sampleSize\>\"", "->", "nMaxCurrent"}], ",", 
