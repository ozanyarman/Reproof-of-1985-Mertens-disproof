Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PHASE", " ", "5", "B", ".8"}], ":", 
    RowBox[{
    "TRUE", " ", "UNCOMPROMISED", " ", "PHASE", " ", "RANDOMIZATION", " ", 
     "ENGINE"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "==="}], "="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n=== PHASE 5B.8: TRUE PHASE RANDOMIZATION ENGINE ===\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Establish", " ", "the", " ", "Real", " ", "Baseline", " ", 
     "Data", " ", "from", " ", "Candidates"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Assuming", "'"}], 
      RowBox[{"finalAtMaxN", "'"}], " ", "contains", " ", "the", " ", 
      "harvested", " ", "candidate", " ", "rows", " ", "with", " ", "peakY"}],
      ",", "curvature", ",", 
     RowBox[{"etc", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Or", " ", "we", " ", "use", " ", "our", " ", "cleaned", " ", "logData", 
     " ", "matrix", " ", "directly"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"realLogData", "=", 
     RowBox[{"Map", "[", 
      RowBox[{"Log", ",", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", "\"\<peakY\>\"", "]"}], ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"#", "[", "\"\<curvature\>\"", "]"}], "]"}], ",", 
             RowBox[{"#", "[", "\"\<Invariant_Q\>\"", "]"}]}], "}"}], "&"}], "/@",
           "finalAtMaxN"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ">", "0"}]}], "&"}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"baseStd", "=", 
     RowBox[{"Standardize", "[", "realLogData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"baseCov", "=", 
     RowBox[{"Covariance", "[", "baseStd", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"baseVals", ",", "baseVecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "baseCov", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"realPC1Var", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"First", "[", "baseVals", "]"}], "/", 
        RowBox[{"Total", "[", "baseVals", "]"}]}], ")"}], "*", "100"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Real Data Baseline PC1 Variance: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"realPC1Var", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Prepare", " ", "the", " ", "Exact", " ", "Kernel", " ", 
     "Parameters", " ", "from", " ", "Storage"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "We", " ", "pull", " ", "the", " ", "exact", " ", "vectors", " ", "used",
       " ", "in", " ", 
      RowBox[{"evaluation", ":", "zeros"}]}], ",", "weights", ",", 
     RowBox[{"and", " ", "base", " ", "coordinates"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nRandomizations", "=", "500"}], ";", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Set", " ", "to", " ", "5000"}], "-", 
      RowBox[{
      "10000", " ", "for", " ", "final", " ", "production", " ", "run"}]}], 
     "*)"}], 
    RowBox[{"trueNullPC1s", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Initializing true randomization loop over \>\"", ",", 
      "nRandomizations", ",", "\"\< realizations...\>\""}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<NOTE: Recomputing full metrics from randomized phase-shifted \
kernels. Please wait...\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"A", ".", "Generate"}], " ", "randomized", " ", "phase", " ",
          "shifts", " ", "for", " ", "every", " ", "term"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"phaseShifts", "=", 
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
            RowBox[{"Length", "[", "psi", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"randomizedPsi", "=", 
          RowBox[{"psi", "+", "phaseShifts"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"B", ".", "Recompute"}], " ", "candidate", " ", "metrics", 
           " ", "under", " ", "randomized", " ", "phases"}], "*)"}], 
         RowBox[{"(*", 
          RowBox[{
          "We", " ", "loop", " ", "through", " ", "the", " ", "evaluated", 
           " ", "candidates", " ", "or", " ", "a", " ", "representative", " ",
            "subset"}], "*)"}], 
         RowBox[{"synthMetrics", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cand", "=", 
                 RowBox[{"finalAtMaxN", "[", 
                  RowBox[{"[", "idx", "]"}], "]"}]}], ",", "baseCoord", ",", 
                "prec", ",", "zH", ",", "pH", ",", "wgt", ",", "evalU", ",", 
                "grid", ",", "vals", ",", "peakY", ",", "curv", ",", "qVal"}],
                "}"}], ",", 
              RowBox[{
               RowBox[{"baseCoord", "=", 
                RowBox[{"cand", "[", "\"\<baseCoord\>\"", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"prec", "=", 
                RowBox[{"safePrec", "[", "baseCoord", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"zH", "=", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{"zeros", ",", "prec"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"pH", "=", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{"randomizedPsi", ",", "prec"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"wgt", "=", 
                RowBox[{"SetPrecision", "[", 
                 RowBox[{
                  RowBox[{"kernelWeights", "*", "alphas"}], ",", "prec"}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{"Re", "-", 
                 RowBox[{
                 "evaluate", " ", "the", " ", "candidate", " ", "function", 
                  " ", "with", " ", "randomized", " ", "phases"}]}], "*)"}], 
               RowBox[{
                RowBox[{"evalU", "[", "u_", "]"}], ":=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"cand", "[", "\"\<pipeline\>\"", "]"}], "==", 
                   "\"\<g0\>\""}], ",", 
                  RowBox[{"2", "*", 
                   RowBox[{"Total", "[", 
                    RowBox[{"wgt", "*", 
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"zH", "*", 
                    RowBox[{"(", 
                    RowBox[{"baseCoord", "+", "u"}], ")"}]}], "-", "pH"}], 
                    "]"}]}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"-", "2"}], "*", 
                   RowBox[{"Total", "[", 
                    RowBox[{"wgt", "*", 
                    RowBox[{"Cos", "[", 
                    RowBox[{
                    RowBox[{"zH", "*", 
                    RowBox[{"(", 
                    RowBox[{"baseCoord", "+", "u"}], ")"}]}], "-", "pH"}], 
                    "]"}]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{
                 "Fast", " ", "local", " ", "sampling", " ", "around", " ", 
                  "peak", " ", "to", " ", "extract", " ", "surrogate", " ", 
                  "A"}], ",", "D2", ",", 
                 RowBox[{"D4", "/", "metrics"}]}], "*)"}], 
               RowBox[{"grid", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"k", "*", "0.001"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", 
                    RowBox[{"-", "20"}], ",", "20"}], "}"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"vals", "=", 
                RowBox[{"evalU", "/@", "grid"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"peakY", "=", 
                RowBox[{"Max", "[", "vals", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"curv", "=", 
                RowBox[{"Quiet", "[", 
                 RowBox[{"Check", "[", 
                  RowBox[{
                   RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{"Fit", "[", 
                    RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"grid", ",", "vals"}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "x", ",", 
                    RowBox[{"x", "^", "2"}]}], "}"}], ",", "x"}], "]"}], ",", 
                    "x", ",", "2"}], "]"}], ",", "0"}], "]"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"qVal", "=", 
                RowBox[{"Abs", "[", 
                 RowBox[{"peakY", "/", 
                  RowBox[{"Max", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Abs", "[", "curv", "]"}]}], "]"}]}], "]"}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"peakY", ",", 
                 RowBox[{"Abs", "[", "curv", "]"}], ",", "qVal"}], "}"}]}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"idx", ",", "1", ",", 
              RowBox[{"Length", "[", "finalAtMaxN", "]"}]}], "}"}]}], "]"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"C", ".", "Clean"}], " ", "and", " ", "compute", " ", 
           "PC1", " ", "variance", " ", "for", " ", "this", " ", 
           "realization"}], "*)"}], 
         RowBox[{"cleanSynth", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"synthMetrics", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], "&&", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ">", "0"}]}], "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "cleanSynth", "]"}], ">=", "10"}], ",", 
           RowBox[{
            RowBox[{"synthLog", "=", 
             RowBox[{"Map", "[", 
              RowBox[{"Log", ",", "cleanSynth", ",", 
               RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"synthStd", "=", 
             RowBox[{"Quiet", "[", 
              RowBox[{"Standardize", "[", "synthLog", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"MatrixQ", "[", 
                RowBox[{"synthStd", ",", "NumericQ"}], "]"}], "&&", 
               RowBox[{"FreeQ", "[", 
                RowBox[{"synthStd", ",", 
                 RowBox[{"Indeterminate", "|", "DirectedInfinity"}]}], 
                "]"}]}], ",", 
              RowBox[{
               RowBox[{"synthCov", "=", 
                RowBox[{"Covariance", "[", "synthStd", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"sVals", ",", "sVecs"}], "}"}], "=", 
                RowBox[{"Eigensystem", "[", "synthCov", "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"VectorQ", "[", 
                   RowBox[{"sVals", ",", "NumericQ"}], "]"}], "&&", 
                  RowBox[{
                   RowBox[{"Total", "[", "sVals", "]"}], ">", "0"}]}], ",", 
                 RowBox[{
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"trueNullPC1s", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"First", "[", "sVals", "]"}], "/", 
                    RowBox[{"Total", "[", "sVals", "]"}]}], ")"}], "*", 
                    "100"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}]}],
           "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"iter", ",", "1", ",", "nRandomizations"}], "}"}]}], "]"}], 
      ",", 
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"iter", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "nRandomizations"}], "}"}]}], "]"}]}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Statistical", " ", "Analysis", " ", "of", " ", "True", " ", 
     "Null", " ", "Distribution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trueNullClean", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"trueNullPC1s", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
         RowBox[{"0", "<=", "#", "<=", "100"}]}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "trueNullClean", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"nullMean", "=", 
        RowBox[{"Mean", "[", "trueNullClean", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nullSD", "=", 
        RowBox[{"StandardDeviation", "[", "trueNullClean", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nullMedian", "=", 
        RowBox[{"Median", "[", "trueNullClean", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nullCI", "=", 
        RowBox[{"Quantile", "[", 
         RowBox[{"trueNullClean", ",", 
          RowBox[{"{", 
           RowBox[{"0.025", ",", "0.975"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zScoreTrue", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"realPC1Var", "-", "nullMean"}], ")"}], "/", "nullSD"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<\\n=== TRUE PHASE RANDOMIZATION RESULTS ===\>\"", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Realized Iterations: \>\"", ",", 
         RowBox[{"Length", "[", "trueNullClean", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<True Null Mean PC1 Variance: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"nullMean", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<% (SD: \>\"", 
         ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"nullSD", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", "\"\<%)\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<True Null Median PC1 Variance: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"nullMedian", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<True Null 95% Confidence Interval: [\>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"nullCI", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<%, \>\"", ",", 
         
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"nullCI", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<%]\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Actual Data PC1 Variance: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"realPC1Var", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "1"}], "}"}]}], "]"}], ",", "\"\<%\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Z-Score against True Phase Null: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"zScoreTrue", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Visualization", " ", "Histogram"}], "*)"}], 
       RowBox[{"histTrue", "=", 
        RowBox[{"Histogram", "[", 
         RowBox[{"trueNullClean", ",", 
          RowBox[{"{", "2", "}"}], ",", 
          RowBox[{
          "PlotLabel", "->", 
           "\"\<True Phase-Randomization Null vs Actual Data\>\""}], ",", 
          RowBox[{"AxesLabel", "->", 
           RowBox[{"{", 
            RowBox[{
            "\"\<PC1 Variance Explained (%)\>\"", ",", "\"\<Frequency\>\""}], 
            "}"}]}], ",", 
          RowBox[{"Epilog", "->", 
           RowBox[{"{", 
            RowBox[{"Red", ",", "Thick", ",", 
             RowBox[{"Line", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"realPC1Var", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"realPC1Var", ",", "50"}], "}"}]}], "}"}], "]"}], 
             ",", 
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Actual (50%)\>\"", ",", "Red", ",", "Bold"}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"realPC1Var", ",", "55"}], "}"}]}], "]"}]}], "}"}]}], 
          ",", 
          RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "histTrue", "]"}], ";"}], ",", 
      RowBox[{
      "Print", "[", 
       "\"\<Warning: True null execution did not accumulate valid numeric \
matrices. Check local array structures.\>\"", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n=== PHASE 5B.8 COMPLETE ===\>\"", "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.993756566651083*^9, 3.993756566673422*^9}},
