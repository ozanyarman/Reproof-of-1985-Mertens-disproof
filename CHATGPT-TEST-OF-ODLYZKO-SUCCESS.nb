        "\"\<\\nAmbient test \>\"", ",", "ambientPosition", ",", 
         "\"\< / \>\"", ",", 
         RowBox[{"Length", "[", "candidateAmbientIndices", "]"}], ",", 
         "\"\< | zero index \>\"", ",", "ambientOriginalIndex"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"augmentedOrdinates", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"candidateSelectedZeros", ",", "ambientGamma"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"augmentedAudit", "=", 
        RowBox[{"scalingAudit", "[", 
         RowBox[{"augmentedOrdinates", ",", "Kscale"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"TrueQ", "[", 
           RowBox[{
           "augmentedAudit", "[", "\"\<FloorStableHeuristically\>\"", "]"}], 
           "]"}]}], ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<FAIL: Scaling floor is numerically unstable for ambient zero \
\>\"", ",", "ambientOriginalIndex"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"allAmbientPassed", "=", "False"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ambientResults", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<AmbientPosition\>\"", "->", "ambientPosition"}], 
              ",", 
              RowBox[{
              "\"\<OriginalZeroIndex\>\"", "->", "ambientOriginalIndex"}], 
              ",", 
              RowBox[{"\"\<Status\>\"", "->", "\"\<FloorUnstable\>\""}], ",", 
              
              RowBox[{"\"\<GSMinimum\>\"", "->", 
               RowBox[{"Missing", "[", "\"\<NotComputed\>\"", "]"}]}]}], 
             "|>"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"augmentedBasis", "=", 
        RowBox[{"relationLatticeBasis", "[", 
         RowBox[{"augmentedOrdinates", ",", "Kscale"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"augmentedReduceTiming", "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{"reducedAugmentedBasis", "=", 
           RowBox[{"LatticeReduce", "[", "augmentedBasis", "]"}]}], ";"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"augmentedGSTiming", "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{"augmentedGSMinimum", "=", 
           RowBox[{"computeGSMinimum", "[", "reducedAugmentedBasis", "]"}]}], 
          ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"augmentedPassed", "=", 
        RowBox[{"augmentedGSMinimum", ">=", "requiredAugmentedThreshold"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"ambientResults", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<AmbientPosition\>\"", "->", "ambientPosition"}], ",", 
           
           RowBox[{
           "\"\<OriginalZeroIndex\>\"", "->", "ambientOriginalIndex"}], ",", 
           RowBox[{"\"\<Gamma\>\"", "->", 
            RowBox[{"N", "[", 
             RowBox[{"ambientGamma", ",", "30"}], "]"}]}], ",", 
           RowBox[{"\"\<GSMinimum\>\"", "->", 
            RowBox[{"N", "[", 
             RowBox[{"augmentedGSMinimum", ",", "30"}], "]"}]}], ",", 
           RowBox[{
           "\"\<RequiredThreshold\>\"", "->", "requiredAugmentedThreshold"}], 
           ",", 
           RowBox[{"\"\<Passed\>\"", "->", "augmentedPassed"}], ",", 
           RowBox[{"\"\<ReductionSeconds\>\"", "->", 
            RowBox[{"augmentedReduceTiming", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<GSSeconds\>\"", "->", 
            RowBox[{"augmentedGSTiming", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "|>"}]}], "]"}], ";", 
