          ",", "crestWidth", ",", "Q", ",", "topCosines", ",", "cosMean", ",",
          "cos99", ",", "baselineCurrent", ",", "deltaBaseline", ",", "u1", 
         ",", "u2"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"zc", ",", "pc", ",", "ac", ",", "kk"}], "}"}], "=", 
         "kernelData"}], ";", "\[IndentingNewLine]", 
        RowBox[{"prec", "=", 
         RowBox[{"safePrec", "[", 
          RowBox[{"cand", "[", "\"\<baseCoord\>\"", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"zc", ",", "prec"}], "]"}]}], ";", 
        RowBox[{"pH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"pc", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"aH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"ac", ",", "prec"}], "]"}]}], ";", 
        RowBox[{"kH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"kk", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wgt", "=", 
         RowBox[{"kH", "*", "aH"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"base", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"cand", "[", "\"\<baseCoord\>\"", "]"}], ",", "prec"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"absY", "[", "u_", "]"}], ":=", 
         RowBox[{"base", "+", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"u", ",", "prec"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"evalU", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cand", "[", "\"\<pipeline\>\"", "]"}], "==", 
            "\"\<g0\>\""}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"zH", "*", 
                   RowBox[{"absY", "[", "#", "]"}]}], "-", "pH"}], "]"}]}], 
               "]"}]}], ")"}], "&"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{
                  RowBox[{"zH", "*", 
                   RowBox[{"absY", "[", "#", "]"}]}], "-", "pH"}], "]"}]}], 
               "]"}]}], ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gridCoarse", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"k", "*", "0.01"}], ",", 
