          RowBox[{"gsMinimum", "<=", "2"}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"n", "^", "2"}], "+", "n"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{"2", " ", "n"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"root", "=", 
