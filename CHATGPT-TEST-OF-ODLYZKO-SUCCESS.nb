          RowBox[{"!", 
           RowBox[{"FileExistsQ", "[", "fileName", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"\"\<ERROR: File not found: \>\"", ",", "fileName"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rawText", "=", 
         RowBox[{"Import", "[", 
          RowBox[{"fileName", ",", "\"\<String\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Accept", " ", "spaces"}], ",", "commas", ",", "tabs", ",", 
          
