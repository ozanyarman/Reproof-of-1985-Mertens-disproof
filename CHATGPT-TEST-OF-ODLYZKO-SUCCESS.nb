   RowBox[{
    RowBox[{"dominantModes", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\nEvaluating multi-scale grids, Fourier spectra, and continuous \
FWHM...\>\"", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"vVal", "=", 
        RowBox[{"cand", "[", "\"\<v\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"baseX", "=", 
        RowBox[{"cand", "[", "\"\<peakX\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"prec", "=", 
        RowBox[{"safePrec", "[", "baseX", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Base", " ", "Carrier", " ", "Phase"}], "*)"}], 
       RowBox[{"zH", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"zc4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pH", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"pc4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"phi0Base", "=", 
        RowBox[{
         RowBox[{"zH", "*", 
          RowBox[{"SetPrecision", "[", 
           RowBox[{"baseX", ",", "prec"}], "]"}]}], "-", "pH"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"wgt", "=", 
        RowBox[{
         RowBox[{"SetPrecision", "[", 
          RowBox[{"kk4", ",", "prec"}], "]"}], "*", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"ac4", ",", "prec"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"--", 
             RowBox[{"-", "DYNAMIC"}]}], " ", "DOMINANT", " ", "MODES"}], 
           "&"}], " ", "WEIGHTED", " ", 
          RowBox[{"COHERENCE", "--"}]}], "-"}], "*)"}], 
       RowBox[{"contribs", "=", 
        RowBox[{"2", "*", "wgt", "*", 
         RowBox[{"Cos", "[", "phi0Base", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"top20Idx", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "contribs", "]"}], ",", 
          RowBox[{"-", "20"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"top20Contribs", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"contribs", "[", 
          RowBox[{"[", "top20Idx", "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"top20Phases", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"phi0Base", "[", 
           RowBox[{"[", "top20Idx", "]"}], "]"}], ",", 
          RowBox[{"2", "*", "Pi"}], ",", 
          RowBox[{"-", "Pi"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"dominantModes", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<v\>\"", "->", "vVal"}], ",", 
