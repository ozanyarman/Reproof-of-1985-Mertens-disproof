          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"uGridMeso", ",", "normM"}], "}"}], "]"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Get", " ", "discrete", " ", "guesses", " ", "first", " ", "to", " ", 
         "seed", " ", "FindRoot"}], "*)"}], 
       RowBox[{"leftCandidates", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"uGridMeso", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "<", "0"}], "&&", 
            RowBox[{
             RowBox[{"interpMeso", "[", "#", "]"}], "<=", "0.5"}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rightCandidates", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"uGridMeso", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", ">", "0"}], "&&", 
            RowBox[{
             RowBox[{"interpMeso", "[", "#", "]"}], "<=", "0.5"}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"leftGuess", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "leftCandidates", "]"}], ">", "0"}], ",", 
          RowBox[{"Max", "[", "leftCandidates", "]"}], ",", 
