      RowBox[{"bestRow", "[", "\"\<pipeline\>\"", "]"}], ",", 
      "\"\<  peakY=\>\"", ",", 
      RowBox[{"bestRow", "[", "\"\<peakY\>\"", "]"}], ",", 
      "\"\<  at nMax=\>\"", ",", "maxN"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
