Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"PHASE", " ", "5", "B", ".2"}], ":", 
    RowBox[{"MANIFOLD", " ", "INTERROGATION"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Prepare", " ", "Standardized", " ", "Logarithmic", " ", 
    "Data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"logData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "amps", "]"}], ",", 
        RowBox[{"Log", "[", "d2s", "]"}], ",", 
        RowBox[{"Log", "[", "d4s", "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stdData", "=", 
     RowBox[{"Standardize", "[", "logData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"covMatrix", "=", 
     RowBox[{"Covariance", "[", "stdData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "covMatrix", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Projections", " ", "onto", " ", "Principal", " ", 
     "Components"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- 2D PCA Projections ---\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"projPC12", "=", 
     RowBox[{"stdData", ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vecs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"projPC13", "=", 
     RowBox[{"stdData", ".", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vecs", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"vecs", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"p1", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"projPC12", ",", 
       RowBox[{"PlotLabel", "->", "\"\<Projection: PC1 vs PC2\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<PC1\>\"", ",", "\"\<PC2\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"p2", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"projPC13", ",", 
       RowBox[{"PlotLabel", "->", "\"\<Projection: PC1 vs PC3\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<PC1\>\"", ",", "\"\<PC3\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsRow", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2"}], "}"}], ",", 
       RowBox[{"ImageSize", "->", "800"}]}], "]"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"3.", " ", "Unsupervised", " ", "Clustering"}], "&"}], " ", 
     "Distance", " ", "Geometry"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Nearest-Neighbor & Clustering ---\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"clusters", "=", 
     RowBox[{"FindClusters", "[", "stdData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Distinct clusters detected: \>\"", ",", 
      RowBox[{"Length", "[", "clusters", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"distMatrix", "=", 
     RowBox[{"DistanceMatrix", "[", "stdData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mean pairwise distance: \>\"", ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"Flatten", "[", "distMatrix", "]"}], "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"ArrayPlot", "[", 
      RowBox[{"distMatrix", ",", 
       RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Pairwise Distance Matrix\>\""}]}], 
      "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "PCA", " ", 
     RowBox[{"Stability", ":", 
      RowBox[{"The", " ", "\"\<Top 10\>\"", " ", "Drop", " ", "Test"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n--- Robustness Test: Removing Top 10 Amplitudes ---\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Find", " ", "indices", " ", "of", " ", "the", " ", "10", " ", "largest", 
     " ", "amplitudes"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ordering", "=", 
     RowBox[{"Ordering", "[", "amps", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"truncatedIndices", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"ordering", ",", 
       RowBox[{"-", "10"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"truncLogData", "=", 
     RowBox[{"logData", "[", 
      RowBox[{"[", "truncatedIndices", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"truncStdData", "=", 
     RowBox[{"Standardize", "[", "truncLogData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"truncCov", "=", 
     RowBox[{"Covariance", "[", "truncStdData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"truncVals", ",", "truncVecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "truncCov", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"truncVarExplained", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"truncVals", "/", 
        RowBox[{"Total", "[", "truncVals", "]"}]}], ",", "4"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"origVarExplained", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"vals", "/", 
        RowBox[{"Total", "[", "vals", "]"}]}], ",", "4"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Original Variance Explained (85 pts): \>\"", ",", 
      "origVarExplained"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Truncated Variance Explained (75 pts): \>\"", ",", 
      "truncVarExplained"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Original PC1 Vector:  \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"vecs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Truncated PC1 Vector: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{
        RowBox[{"truncVecs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "angle", " ", "between", " ", "the", " ", 
     "original", " ", "PC1", " ", "and", " ", "truncated", " ", "PC1"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"angle", "=", 
     RowBox[{
      RowBox[{"VectorAngle", "[", 
       RowBox[{
        RowBox[{"vecs", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"truncVecs", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"180", "/", "Pi"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Angle drift of PC1 after dropping top 10 outliers: \>\"", ",", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"angle", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", "\"\< degrees\>\""}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9937474989966097`*^9, 3.993747499013139*^9}},
 CellLabel->
  "In[242]:=",ExpressionUUID->"07196d2b-76ba-4a33-bc56-c9ab22ce9dce"],

