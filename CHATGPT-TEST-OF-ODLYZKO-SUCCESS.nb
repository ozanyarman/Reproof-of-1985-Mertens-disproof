          ",", "exactCurvature", ",", "exactPeakX", ",", "interp", ",", 
         "halfMax", ",", "leftBracket", ",", "rightBracket", ",", "leftRoot", 
         ",", "rightRoot", ",", "leftFWHM", ",", "rightFWHM", ",", 
