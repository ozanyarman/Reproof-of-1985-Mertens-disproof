        RowBox[{"positiveResult", "-", "1.061545"}], ",", "10"}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"positiveResult", "-", "1.061545"}], "]"}], ">", "0.001"}], 
      ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<FAIL: benchmark does not reproduce OtR value. Aborting.\>\"", 
        "]"}], ";", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<PASS: Benchmark successful (Tbench = zeros[[2000]]).\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Convergence window Tconv = zeros[[\>\"", ",", "availableTerms", 
