         RowBox[{
          RowBox[{"#", "[", "\"\<pipeline\>\"", "]"}], "==", 
          RowBox[{"bestRow", "[", "\"\<pipeline\>\"", "]"}]}]}], "&"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bestBase", "=", 
     RowBox[{"bestCand", "[", "\"\<baseCoord\>\"", "]"}]}], ";"}], "\n", 
