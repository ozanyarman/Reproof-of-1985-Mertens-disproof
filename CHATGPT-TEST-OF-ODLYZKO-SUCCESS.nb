                RowBox[{
                 RowBox[{"interp", "[", "u2", "]"}], "-", "halfMax"}], 
                ")"}]}], "<", "0"}], ",", 
             RowBox[{
              RowBox[{"rightBracket", "=", 
               RowBox[{"{", 
