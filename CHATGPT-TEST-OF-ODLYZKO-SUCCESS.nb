           RowBox[{"K", " ", "values"}], ",", "workingPrecision"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"fractionalDistances", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"FractionalPart", "[", "z", "]"}], ",", 
               RowBox[{"1", "-", 
                RowBox[{"FractionalPart", "[", "z", "]"}]}]}], "]"}]}], "]"}],
            ",", "scaled"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"minimumDistance", "=", 
         RowBox[{"Min", "[", "fractionalDistances", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scaledAccuracies", "=", 
         RowBox[{"Accuracy", "/@", "scaled"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"minimumScaledAccuracy", "=", 
         RowBox[{"Min", "[", "scaledAccuracies", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"estimatedUncertainty", "=", 
         RowBox[{"10", "^", 
