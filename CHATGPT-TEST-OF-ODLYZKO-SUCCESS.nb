              RowBox[{"-", "exactCurvature"}], "*", 
              RowBox[{"crestWidth", "^", "2"}]}], ")"}]}], ",", "0"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"topCosines", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"SetPrecision", "[", 
                 RowBox[{
                  RowBox[{"gammaSub", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", "prec"}], "]"}], "*", 
                "base"}], "-", 
               RowBox[{"SetPrecision", "[", 
                RowBox[{
                 RowBox[{"psiSub", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "prec"}], "]"}]}], 
              "]"}], ",", "30"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{"Min", "[", 
              RowBox[{"20", ",", "n"}], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cosMean", "=", 
         RowBox[{"Mean", "[", "topCosines", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cos99", "=", 
         RowBox[{"Count", "[", 
