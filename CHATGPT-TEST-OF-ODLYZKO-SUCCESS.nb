              RowBox[{"\"\<CutoffCountL\>\"", "->", "L"}], ",", 
              RowBox[{"\"\<CutoffT\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"T", ",", "25"}], "]"}]}], ",", 
              RowBox[{"\"\<SelectedCountN\>\"", "->", "n"}], ",", 
              RowBox[{"\"\<RawWeightedSum\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"rawSum", ",", "30"}], "]"}]}], ",", 
              RowBox[{"\"\<InfiniteIndependenceCeiling\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"theoreticalCeiling", ",", "30"}], "]"}]}], ",", 
              RowBox[{
              "\"\<RequiredUniformIndependenceN\>\"", "->", "requiredN"}], 
