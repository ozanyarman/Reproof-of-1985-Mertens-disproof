             RowBox[{"interpMeso", "[", "x", "]"}], "==", "0.5"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "rightGuess"}], "}"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fwhm", "=", 
        RowBox[{"rightRoot", "-", "leftRoot"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
