       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Weighted", " ", "Circular", " ", 
         RowBox[{"Statistics", ":", "R_weighted"}]}], "*)"}], 
       RowBox[{"weightedR", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"top20Contribs", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{"I", "*", "top20Phases"}], "]"}]}], "]"}], "/", 
          RowBox[{"Total", "[", "top20Contribs", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"phaseCoherence", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<v\>\"", "->", "vVal"}], ",", 
           RowBox[{"\"\<R\>\"", "->", "weightedR"}]}], "|>"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "ULTRA"}]}], "-", 
         RowBox[{"CORE", " ", 
          RowBox[{"SCAN", "--"}]}], "-"}], "*)"}], 
       RowBox[{"valsUltra", "=", 
        RowBox[{"evalFastGrid", "[", 
         RowBox[{"baseX", ",", "prec", ",", "uGridUltra"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
