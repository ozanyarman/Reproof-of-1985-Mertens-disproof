   RowBox[{
    RowBox[{"ClearAll", "[", "RunBTBenchmark", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunBTBenchmark", "[", 
      RowBox[{"zeros_List", ",", "alphas_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ambientL", "=", "2000"}], ",", 
         RowBox[{"selectedN", "=", "500"}], ",", 
         RowBox[{"nGamma", "=", "4976"}], ",", "cutoff", ",", "weights", ",", 
         "ranking", ",", "rawSum", ",", "result", ",", "expected", ",", 
         "error", ",", "passed"}], "}"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<\\n=== BEST-TRUDGIAN BENCHMARK ===\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "zeros", "]"}], "<", "2001"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<ERROR: Benchmark requires at least 2001 zeros.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"<|", 
             RowBox[{"\"\<Passed\>\"", "->", "False"}], "|>"}], "]"}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"cutoff", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"zeros", "[", 
             RowBox[{"[", "ambientL", "]"}], "]"}], "+", 
            RowBox[{"zeros", "[", 
             RowBox[{"[", 
              RowBox[{"ambientL", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
          "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"weights", "=", 
         RowBox[{
          RowBox[{"alphas", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"improvedKernel", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"zeros", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "/", 
              "cutoff"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ranking", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Ordering", "[", "weights", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rawSum", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"weights", "[", 
           RowBox[{"[", 
            RowBox[{"ranking", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "selectedN"}], "]"}], "]"}], "]"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{
          RowBox[{"ASFactor", "[", "nGamma", "]"}], " ", "rawSum"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"expected", "=", "1.63825263042225"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"error", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"result", "-", "expected"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"passed", "=", 
         RowBox[{"error", "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Raw weighted sum: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"rawSum", ",", "30"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Calculated bound: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"result", ",", "30"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Expected scale:   \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"expected", ",", "20"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Absolute error:   \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{"error", ",", "10"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Benchmark passed: \>\"", ",", "passed"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Passed\>\"", "->", "passed"}], ",", 
          RowBox[{"\"\<RawSum\>\"", "->", "rawSum"}], ",", 
          RowBox[{"\"\<Bound\>\"", "->", "result"}], ",", 
          RowBox[{"\"\<Error\>\"", "->", "error"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"11.", " ", "SMALL", " ", 
     RowBox[{"EXACT", "/", "NUMERICAL"}], " ", "LATTICE", " ", "VALIDATION"}],
     "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "RunSmallLatticeTest", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunSmallLatticeTest", "[", 
      RowBox[{"zeros_List", ",", "alphas_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cutoff", ",", "contributions", ",", "ranking", ",", 
         "selectedIndices", ",", "selectedZeros", ",", "scale", ",", 
         "scaleAudit", ",", "basis", ",", "reduced", ",", "exactNorms", ",", 
         "exactMinimum", ",", "qrAudit", ",", "qrMinimum", ",", 
         "relativeError", ",", "qrPassed", ",", "latticeTiming"}], "}"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<\\n=== SMALL LATTICE VALIDATION ===\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "zeros", "]"}], "<", 
           RowBox[{"smallAmbientL", "+", "1"}]}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<ERROR: Not enough zeros for small test.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"<|", 
             RowBox[{"\"\<Passed\>\"", "->", "False"}], "|>"}], "]"}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"cutoff", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"zeros", "[", 
             RowBox[{"[", "smallAmbientL", "]"}], "]"}], "+", 
            RowBox[{"zeros", "[", 
             RowBox[{"[", 
              RowBox[{"smallAmbientL", "+", "1"}], "]"}], "]"}]}], ")"}], "/",
           "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"contributions", "=", 
         RowBox[{
          RowBox[{"alphas", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "smallAmbientL"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"improvedKernel", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"zeros", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", "smallAmbientL"}], "]"}], "]"}], "/", 
              "cutoff"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ranking", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Ordering", "[", "contributions", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedIndices", "=", 
         RowBox[{"ranking", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "smallSelectedN"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedZeros", "=", 
         RowBox[{"zeros", "[", 
          RowBox[{"[", "selectedIndices", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scale", "=", 
         RowBox[{"10", "^", "smallKDigits"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"scaleAudit", "=", 
         RowBox[{"ScalingAudit", "[", 
          RowBox[{"selectedZeros", ",", "scale"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Minimum distance to integer after scaling: \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
             "scaleAudit", "[", "\"\<MinimumDistanceToInteger\>\"", "]"}], 
             ",", "12"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Estimated scaled uncertainty: \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"scaleAudit", "[", "\"\<EstimatedUncertainty\>\"", "]"}],
              ",", "12"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Scaling audit passed: \>\"", ",", 
          RowBox[{"scaleAudit", "[", "\"\<Stable\>\"", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"scaleAudit", "[", "\"\<Stable\>\"", "]"}], "]"}]}], ",", 
          
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{"\"\<Passed\>\"", "->", "False"}], "|>"}], "]"}]}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"basis", "=", 
         RowBox[{"RelationLatticeBasis", "[", 
          RowBox[{"selectedZeros", ",", "scale"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Small lattice dimensions: \>\"", ",", 
          RowBox[{"Dimensions", "[", "basis", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"latticeTiming", "=", 
         RowBox[{"AbsoluteTiming", "[", 
          RowBox[{
           RowBox[{"reduced", "=", 
            RowBox[{"LatticeReduce", "[", "basis", "]"}]}], ";"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Small LatticeReduce time: \>\"", ",", 
          RowBox[{"latticeTiming", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< seconds\>\""}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<Computing exact Gram-Schmidt...\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exactNorms", "=", 
         RowBox[{"ExactGSNormsSquared", "[", "reduced", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"exactMinimum", "=", 
         RowBox[{"Min", "[", "exactNorms", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Exact minimum squared norm: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"exactMinimum", ",", "40"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<Computing stabilized QR audit...\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qrAudit", "=", 
         RowBox[{"StableQRAudit", "[", 
          RowBox[{"reduced", ",", "smallKDigits"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qrMinimum", "=", 
         RowBox[{"qrAudit", "[", "\"\<FinalMinimumSquared\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"relativeError", "=", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"qrMinimum", "-", "exactMinimum"}], "]"}], "/", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"Abs", "[", "exactMinimum", "]"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qrPassed", "=", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"qrAudit", "[", "\"\<Stable\>\"", "]"}], "]"}], "&&", 
          RowBox[{"relativeError", "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "30"}]}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<QR minimum squared norm: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"qrMinimum", ",", "40"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Exact/QR relative error: \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{"relativeError", ",", "12"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Exact/QR test passed: \>\"", ",", "qrPassed"}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Passed\>\"", "->", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"scaleAudit", "[", "\"\<Stable\>\"", "]"}], "]"}], "&&", 
            "qrPassed"}]}], ",", 
          RowBox[{"\"\<ExactMinimum\>\"", "->", "exactMinimum"}], ",", 
          RowBox[{"\"\<QRMinimum\>\"", "->", "qrMinimum"}], ",", 
          RowBox[{"\"\<RelativeError\>\"", "->", "relativeError"}], ",", 
          RowBox[{"\"\<QRAudit\>\"", "->", "qrAudit"}]}], "|>"}]}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"12.", " ", "RECONNAISSANCE"}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ScanCutoff", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ScanCutoff", "[", 
      RowBox[{
      "zeros_List", ",", "alphas_List", ",", "ambientL_Integer", ",", 
       "maximumSelected_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cutoff", ",", "contributions", ",", "ranking", ",", 
         "sortedContributions", ",", "cumulative", ",", "limit", ",", 
         "records", ",", "rawSum", ",", "requiredN", ",", "bound", ",", 
         "margin"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"ambientL", ">=", 
           RowBox[{"Length", "[", "zeros", "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"cutoff", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"zeros", "[", 
             RowBox[{"[", "ambientL", "]"}], "]"}], "+", 
            RowBox[{"zeros", "[", 
             RowBox[{"[", 
              RowBox[{"ambientL", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
          "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"contributions", "=", 
         RowBox[{
          RowBox[{"alphas", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"improvedKernel", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"zeros", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "/", 
              "cutoff"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ranking", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Ordering", "[", "contributions", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sortedContributions", "=", 
         RowBox[{"contributions", "[", 
          RowBox[{"[", "ranking", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"cumulative", "=", 
         RowBox[{"Accumulate", "[", "sortedContributions", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"limit", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"maximumSelected", ",", "ambientL"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rawSum", "=", 
             RowBox[{"cumulative", "[", 
              RowBox[{"[", "selectedN", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"requiredN", "=", 
             RowBox[{"RequiredUniformN", "[", 
              RowBox[{"rawSum", ",", "targetBarrier"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"requiredN", "===", "Infinity"}], ",", 
              RowBox[{
               RowBox[{"bound", "=", 
                RowBox[{"2", " ", "rawSum"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"margin", "=", 
                RowBox[{"bound", "-", "targetBarrier"}]}]}], ",", 
              RowBox[{
               RowBox[{"bound", "=", 
                RowBox[{
                 RowBox[{"ASFactor", "[", "requiredN", "]"}], " ", 
                 "rawSum"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"margin", "=", 
                RowBox[{"bound", "-", "targetBarrier"}]}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<AmbientL\>\"", "->", "ambientL"}], ",", 
              RowBox[{"\"\<SelectedN\>\"", "->", "selectedN"}], ",", 
              RowBox[{"\"\<Cutoff\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"cutoff", ",", "25"}], "]"}]}], ",", 
              RowBox[{"\"\<RawSum\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"rawSum", ",", "35"}], "]"}]}], ",", 
              RowBox[{"\"\<RequiredN\>\"", "->", "requiredN"}], ",", 
              RowBox[{"\"\<ConditionalBound\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"bound", ",", "35"}], "]"}]}], ",", 
              RowBox[{"\"\<Margin\>\"", "->", 
               RowBox[{"N", "[", 
                RowBox[{"margin", ",", "35"}], "]"}]}], ",", 
              RowBox[{"\"\<Crosses2\>\"", "->", 
               RowBox[{"TrueQ", "[", 
                RowBox[{
                 RowBox[{"requiredN", "=!=", "Infinity"}], "&&", 
                 RowBox[{"bound", ">", "targetBarrier"}]}], "]"}]}]}], 
             "|>"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"selectedN", ",", "1", ",", "limit"}], "}"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", "records"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "RunReconnaissance", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunReconnaissance", "[", 
      RowBox[{"zeros_List", ",", "alphas_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "cutoffs", ",", "allRecords", ",", "crossing", ",", "preferred", ",", 
         "ranked", ",", "chosen"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", "\"\<\\n=== FULL RECONNAISSANCE ===\>\"", "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"cutoffs", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"fullCutoffs", ",", 
           RowBox[{
            RowBox[{"#", "<", 
             RowBox[{"Length", "[", "zeros", "]"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allRecords", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Scanning ambient L = \>\"", ",", "ambientL", ",", 
                "\"\<...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"ScanCutoff", "[", 
               RowBox[{
               "zeros", ",", "alphas", ",", "ambientL", ",", 
                "fullMaximumSelected"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"ambientL", ",", "cutoffs"}], "}"}]}], "]"}], ",", 
           "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"crossing", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"allRecords", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", "[", "\"\<Crosses2\>\"", "]"}], "]"}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Conditional crossings found: \>\"", ",", 
          RowBox[{"Length", "[", "crossing", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "crossing", "]"}], "==", "0"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"preferred", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"crossing", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Margin\>\"", "]"}], ">=", 
              "desiredBarrierMargin"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", "\"\<SelectedN\>\"", "]"}], "<=", 
              "maximumCandidateDimension"}]}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ranked", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "preferred", "]"}], ">", "0"}], ",", 
           RowBox[{"SortBy", "[", 
            RowBox[{"preferred", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<SelectedN\>\"", "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"#", "[", "\"\<AmbientL\>\"", "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"#", "[", "\"\<RequiredN\>\"", "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"#", "[", "\"\<Margin\>\"", "]"}]}], "&"}]}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"SortBy", "[", 
            RowBox[{"crossing", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<SelectedN\>\"", "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"#", "[", "\"\<RequiredN\>\"", "]"}], "&"}], ",", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"#", "[", "\"\<Margin\>\"", "]"}]}], "&"}]}], 
              "}"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"candidateCSV", ",", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Values", "/@", "ranked"}], ",", 
            RowBox[{"Keys", "[", 
             RowBox[{"First", "[", "ranked", "]"}], "]"}]}], "]"}], ",", 
          "\"\<CSV\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<\\nTop candidate rows:\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"c", "[", "\"\<AmbientL\>\"", "]"}], ",", 
                 RowBox[{"c", "[", "\"\<SelectedN\>\"", "]"}], ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"c", "[", "\"\<RawSum\>\"", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"12", ",", "9"}], "}"}]}], "]"}], ",", 
                 RowBox[{"c", "[", "\"\<RequiredN\>\"", "]"}], ",", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"c", "[", "\"\<ConditionalBound\>\"", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"12", ",", "9"}], "}"}]}], "]"}], ",", 
                 RowBox[{"ScientificForm", "[", 
                  RowBox[{
                   RowBox[{"c", "[", "\"\<Margin\>\"", "]"}], ",", "5"}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"c", ",", 
                 RowBox[{"Take", "[", 
                  RowBox[{"ranked", ",", 
                   RowBox[{"Min", "[", 
                    RowBox[{"20", ",", 
                    RowBox[{"Length", "[", "ranked", "]"}]}], "]"}]}], 
                  "]"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Ambient L\>\"", ",", "\"\<Selected n\>\"", ",", 
               "\"\<Raw S\>\"", ",", "\"\<Required N\[Gamma]\>\"", ",", 
               "\"\<Bound\>\"", ",", "\"\<Margin\>\""}], "}"}]}], "]"}], ",", 
           
           RowBox[{"Frame", "->", "All"}], ",", 
           RowBox[{"Background", "->", 
            RowBox[{"{", 
             RowBox[{"None", ",", 
              RowBox[{"{", 
               RowBox[{"LightGray", ",", "None"}], "}"}]}], "}"}]}]}], "]"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"chosen", "=", 
         RowBox[{"First", "[", "ranked", "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Print", "[", "\"\<\\nChosen candidate:\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "chosen", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Chosen\>\"", "->", "chosen"}], ",", 
          RowBox[{"\"\<RankedCandidates\>\"", "->", "ranked"}], ",", 
          RowBox[{"\"\<AllRecords\>\"", "->", "allRecords"}]}], "|>"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
