           ",", 
           RowBox[{"Abs", "[", 
            RowBox[{"peakU", "-", 
             RowBox[{"(", 
              RowBox[{"x", "/.", " ", "rightRoot"}], ")"}]}], "]"}], ",", 
           "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"continuousFWHM", "=", 
