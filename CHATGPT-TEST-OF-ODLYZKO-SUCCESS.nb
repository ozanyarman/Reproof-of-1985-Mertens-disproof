   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ReconstructCandidate", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ReconstructCandidate", "[", 
      RowBox[{"zeros_List", ",", "alphas_List", ",", "summary_Association"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ambientL", ",", "selectedN", ",", "cutoff", ",", "contributions", 
         ",", "ranking", ",", "selectedIndices", ",", "selectedZeros", ",", 
         "selectedContributions", ",", "ambientIndices", ",", "rawSum"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"ambientL", "=", 
         RowBox[{"summary", "[", "\"\<AmbientL\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedN", "=", 
         RowBox[{"summary", "[", "\"\<SelectedN\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cutoff", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"zeros", "[", 
             RowBox[{"[", "ambientL", "]"}], "]"}], "+", 
            RowBox[{"zeros", "[", 
             RowBox[{"[", 
              RowBox[{"ambientL", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
          "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"contributions", "=", 
         RowBox[{
          RowBox[{"alphas", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"improvedKernel", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"zeros", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", "ambientL"}], "]"}], "]"}], "/", 
              "cutoff"}], ")"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ranking", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Ordering", "[", "contributions", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedIndices", "=", 
         RowBox[{"ranking", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "selectedN"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedZeros", "=", 
         RowBox[{"zeros", "[", 
          RowBox[{"[", "selectedIndices", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedContributions", "=", 
         RowBox[{"contributions", "[", 
          RowBox[{"[", "selectedIndices", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ambientIndices", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "ambientL", "]"}], ",", "selectedIndices"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rawSum", "=", 
         RowBox[{"Total", "[", "selectedContributions", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Summary\>\"", "->", "summary"}], ",", 
          RowBox[{"\"\<AmbientL\>\"", "->", "ambientL"}], ",", 
          RowBox[{"\"\<SelectedN\>\"", "->", "selectedN"}], ",", 
          RowBox[{"\"\<RequiredN\>\"", "->", 
           RowBox[{"summary", "[", "\"\<RequiredN\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Cutoff\>\"", "->", "cutoff"}], ",", 
          RowBox[{"\"\<SelectedIndices\>\"", "->", "selectedIndices"}], ",", 
          RowBox[{"\"\<SelectedZeros\>\"", "->", "selectedZeros"}], ",", 
          RowBox[{
          "\"\<SelectedContributions\>\"", "->", "selectedContributions"}], 
          ",", 
          RowBox[{"\"\<AmbientIndices\>\"", "->", "ambientIndices"}], ",", 
          RowBox[{"\"\<RawSum\>\"", "->", "rawSum"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"14.", " ", "FULL", " ", "BASE", " ", "PILOT"}], "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "RunFullBasePilot", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"RunFullBasePilot", "[", 
      RowBox[{"zeros_List", ",", "candidate_Association"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "selectedZeros", ",", "selectedN", ",", "requiredN", ",", "rawSum", 
         ",", "minimumAccuracy", ",", "maximumKDigits", ",", "kDigits", ",", 
         "scale", ",", "scaleAudit", ",", "basis", ",", "reduced", ",", 
         "reductionTiming", ",", "qrAudit", ",", "gsMinimum", ",", 
         "certifiedN", ",", "certifiedBound", ",", "requestedThreshold", ",", 
         "requestedPassed", ",", "status", ",", "result"}], "}"}], ",", 
       RowBox[{
        RowBox[{"selectedZeros", "=", 
         RowBox[{"candidate", "[", "\"\<SelectedZeros\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"selectedN", "=", 
         RowBox[{"candidate", "[", "\"\<SelectedN\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"requiredN", "=", 
         RowBox[{"candidate", "[", "\"\<RequiredN\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rawSum", "=", 
         RowBox[{"candidate", "[", "\"\<RawSum\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<\\n============================================================\
\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\< FULL BASE PILOT\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<============================================================\>\"\
", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Ambient L:    \>\"", ",", 
          RowBox[{"candidate", "[", "\"\<AmbientL\>\"", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Selected n:   \>\"", ",", "selectedN"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Required N\[Gamma]:  \>\"", ",", "requiredN"}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Raw sum:      \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"rawSum", ",", "30"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Conditional score: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ASFactor", "[", "requiredN", "]"}], " ", "rawSum"}], 
            ",", "30"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"minimumAccuracy", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"Accuracy", "/@", "selectedZeros"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maximumKDigits", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"minimumAccuracy", "-", "accuracyGuardDigits"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"kDigits", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"requestedFullKDigits", ",", "maximumKDigits"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"kDigits", "<=", "0"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<ERROR: Insufficient zero accuracy.\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scale", "=", 
         RowBox[{"10", "^", "kDigits"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Minimum input accuracy: \>\"", ",", "minimumAccuracy"}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Using K = 10^\>\"", ",", "kDigits"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"scaleAudit", "=", 
         RowBox[{"ScalingAudit", "[", 
          RowBox[{"selectedZeros", ",", "scale"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Minimum scaled distance to integer: \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{
             "scaleAudit", "[", "\"\<MinimumDistanceToInteger\>\"", "]"}], 
             ",", "12"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Estimated scaled uncertainty: \>\"", ",", 
          RowBox[{"ScientificForm", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"scaleAudit", "[", "\"\<EstimatedUncertainty\>\"", "]"}],
              ",", "12"}], "]"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Floor stability: \>\"", ",", 
          RowBox[{"scaleAudit", "[", "\"\<Stable\>\"", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"scaleAudit", "[", "\"\<Stable\>\"", "]"}], "]"}]}], ",", 
          
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<BASE PILOT STOPPED: unstable Floor[K gamma].\>\"", "]"}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"basis", "=", 
         RowBox[{"RelationLatticeBasis", "[", 
          RowBox[{"selectedZeros", ",", "scale"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Base lattice dimensions: \>\"", ",", 
          RowBox[{"Dimensions", "[", "basis", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"reductionTiming", "=", 
         RowBox[{"AbsoluteTiming", "[", 
          RowBox[{
           RowBox[{"reduced", "=", 
            RowBox[{"LatticeReduce", "[", "basis", "]"}]}], ";"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<LatticeReduce time: \>\"", ",", 
          RowBox[{"reductionTiming", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< seconds\>\""}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"qrAudit", "=", 
         RowBox[{"StableQRAudit", "[", 
          RowBox[{"reduced", ",", "kDigits"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"qrAudit", "[", "\"\<Stable\>\"", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"status", "=", "\"\<QRUnstable\>\""}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
           "Print", "[", 
            "\"\<BASE PILOT INCONCLUSIVE: QR minimum did not stabilize.\>\"", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"result", "=", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Status\>\"", "->", "status"}], ",", 
              RowBox[{"\"\<Candidate\>\"", "->", "candidate"}], ",", 
              RowBox[{"\"\<KDigits\>\"", "->", "kDigits"}], ",", 
              RowBox[{"\"\<QRAudit\>\"", "->", "qrAudit"}]}], "|>"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Export", "[", 
            RowBox[{"baseResultFile", ",", "result"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "result", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gsMinimum", "=", 
         RowBox[{"qrAudit", "[", "\"\<FinalMinimumSquared\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"certifiedN", "=", 
         RowBox[{"LargestCertifiedBaseN", "[", 
          RowBox[{"selectedN", ",", "gsMinimum"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"certifiedBound", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"certifiedN", ">", "0"}], ",", 
           RowBox[{
            RowBox[{"ASFactor", "[", "certifiedN", "]"}], " ", "rawSum"}], 
           ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"requestedThreshold", "=", 
         RowBox[{"BaseThreshold", "[", 
          RowBox[{"selectedN", ",", "requiredN"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"requestedPassed", "=", 
         RowBox[{"gsMinimum", ">=", "requestedThreshold"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<\\n=== BASE RESULT ===\>\"", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Stable minimum GS squared norm: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"gsMinimum", ",", "40"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Threshold for requested N\[Gamma] = \>\"", ",", "requiredN", 
          ",", "\"\<: \>\"", ",", "requestedThreshold"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Requested N\[Gamma] passed: \>\"", ",", "requestedPassed"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Largest base N\[Gamma] supported: \>\"", ",", "certifiedN"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Bound supported by base lattice: \>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{"certifiedBound", ",", "40"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"status", "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"!", "requestedPassed"}], ",", "\"\<BaseFailed\>\"", ",", 
           RowBox[{"certifiedBound", "<=", "targetBarrier"}], ",", 
           "\"\<BasePassedButNoCrossing\>\"", ",", "True", ",", 
           "\"\<BasePassed\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<BASE STATUS: \>\"", ",", "status"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Status\>\"", "->", "status"}], ",", 
           RowBox[{"\"\<Candidate\>\"", "->", "candidate"}], ",", 
           RowBox[{"\"\<KDigits\>\"", "->", "kDigits"}], ",", 
           RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
           RowBox[{"\"\<ScalingAudit\>\"", "->", "scaleAudit"}], ",", 
           RowBox[{"\"\<GSMinimum\>\"", "->", "gsMinimum"}], ",", 
           RowBox[{"\"\<RequestedThreshold\>\"", "->", "requestedThreshold"}],
            ",", 
           RowBox[{"\"\<RequestedPassed\>\"", "->", "requestedPassed"}], ",", 
           
           RowBox[{"\"\<CertifiedN\>\"", "->", "certifiedN"}], ",", 
           RowBox[{"\"\<CertifiedBound\>\"", "->", "certifiedBound"}], ",", 
           RowBox[{"\"\<QRAudit\>\"", "->", "qrAudit"}]}], "|>"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"baseResultFile", ",", "result"}], "]"}], ";", 
        "\[IndentingNewLine]", "result"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
