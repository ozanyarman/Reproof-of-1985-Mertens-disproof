        "\[IndentingNewLine]", 
        RowBox[{"scaledOrdinates", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"K", " ", "ordinates"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"identity", "=", 
         RowBox[{"IdentityMatrix", "[", "count", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Append", ",", 
          RowBox[{"{", 
           RowBox[{"identity", ",", "scaledOrdinates"}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
