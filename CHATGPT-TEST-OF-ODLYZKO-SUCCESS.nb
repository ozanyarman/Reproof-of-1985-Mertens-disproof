Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"PHASE", " ", "5", 
    RowBox[{"B", ":", 
     RowBox[{"THE", " ", "STATISTICAL", " ", "MECHANICS", " ", "ENGINE"}]}]}],
    "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== PHASE 5B: OBSERVABLE GEOMETRY & PCA ===\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "1.", " ", "Safely", " ", "Import", " ", "Native", " ", "WXF", " ", 
     "Data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wxfPath", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<Phase5A_Harvest.wxf\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FileExistsQ", "[", "wxfPath", "]"}]}], ",", 
      RowBox[{
       RowBox[{
       "Print", "[", 
        "\"\<Error: WXF file not found. Please export Phase 5A using 'WXF' \
format.\>\"", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"harvestData", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"wxfPath", ",", "\"\<WXF\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nObs", "=", 
     RowBox[{"Length", "[", "harvestData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Successfully loaded \>\"", ",", "nObs", ",", 
      "\"\< strict observations.\>\""}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Extract", " ", "Key", " ", "Observables", " ", 
     RowBox[{"(", 
      RowBox[{
      "Using", " ", "Absolute", " ", "Values", " ", "for", " ", "Log", " ", 
       "Spaces"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"amps", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "[", "\"\<Amplitude\>\"", "]"}], "]"}], "&"}], "/@", 
      "harvestData"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d2s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "[", "\"\<CurvatureD2\>\"", "]"}], "]"}], "&"}], "/@", 
      "harvestData"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d4s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"#", "[", "\"\<FourthDerivD4\>\"", "]"}], "]"}], "&"}], "/@", 
      "harvestData"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"peakYs", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<peakY\>\"", "]"}], "&"}], "/@", 
      "harvestData"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Look", " ", "Before", " ", "We", " ", 
     RowBox[{"Fit", ":", 
      RowBox[{"Visual", " ", "Geometry"}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nGenerating Exploratory Manifold Geometries...\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plot1", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"d2s", ",", "amps"}], "}"}], "]"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Log|D2| vs Log|Amplitude|\>\""}], ",", 
       
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Log|D2|\>\"", ",", "\"\<Log|A|\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plot2", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"d4s", ",", "amps"}], "}"}], "]"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Log|D4| vs Log|Amplitude|\>\""}], ",", 
       
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Log|D4|\>\"", ",", "\"\<Log|A|\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plot3", "=", 
     RowBox[{"ListLogLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"d2s", ",", "d4s"}], "}"}], "]"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Log|D2| vs Log|D4|\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Log|D2|\>\"", ",", "\"\<Log|D4|\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"plot4", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"peakYs", ",", "amps"}], "}"}], "]"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Macro peakY vs Micro |A|\>\""}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<peakY\>\"", ",", "\"\<|A|\>\""}], "}"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"GraphicsGrid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"plot1", ",", "plot2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"plot3", ",", "plot4"}], "}"}]}], "}"}], ",", 
       RowBox[{"ImageSize", "->", "800"}]}], "]"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Degrees", " ", "of", " ", 
     RowBox[{"Freedom", ":", 
      RowBox[{"Principal", " ", "Component", " ", "Analysis", " ", 
       RowBox[{"(", "PCA", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n--- Dimensionality & Constraints (PCA) ---\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "standardize", " ", "the", " ", "log"}], "-", 
     RowBox[{
     "space", " ", "observables", " ", "to", " ", "find", " ", "the", " ", 
      "underlying", " ", "manifold"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logFeatures", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "amps", "]"}], ",", 
        RowBox[{"Log", "[", "d2s", "]"}], ",", 
        RowBox[{"Log", "[", "d4s", "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stdData", "=", 
     RowBox[{"Standardize", "[", "logFeatures", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"covMatrix", "=", 
     RowBox[{"Covariance", "[", "stdData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", "covMatrix", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sortedIndices", "=", 
     RowBox[{"Ordering", "[", 
      RowBox[{"eigenvalues", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sortedEigs", "=", 
     RowBox[{"eigenvalues", "[", 
      RowBox[{"[", "sortedIndices", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalVar", "=", 
     RowBox[{"Total", "[", "sortedEigs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"varianceExplained", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "/", "totalVar"}], ")"}], "&"}], "/@", "sortedEigs"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Total Variance Explained by Principal Components (Log Space):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<PC\>\"", ",", "i", ",", "\"\<: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"varianceExplained", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "*", "100"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
         "\"\<% of variance (Eigenvalue: \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"sortedEigs", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", "\"\<)\>\""}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<    Vector: \>\"", ",", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"eigenvectors", "[", 
             RowBox[{"[", "sortedIndices", "]"}], "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "0.01"}], "]"}]}], "]"}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "sortedEigs", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Unbiased", " ", "Correlation", " ", "Hunting"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- Raw Linear Correlations ---\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"rawFeatures", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"amps", ",", "d2s", ",", "d4s", ",", "peakYs"}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"corrMatrix", "=", 
     RowBox[{"Correlation", "[", "rawFeatures", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"TableForm", "[", 
      RowBox[{"corrMatrix", ",", 
       RowBox[{"TableHeadings", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "\"\<|A|\>\"", ",", "\"\<|D2|\>\"", ",", "\"\<|D4|\>\"", ",", 
            "\"\<peakY\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
           "\"\<|A|\>\"", ",", "\"\<|D2|\>\"", ",", "\"\<|D4|\>\"", ",", 
            "\"\<peakY\>\""}], "}"}]}], "}"}]}]}], "]"}], "]"}], 
    ";"}]}]}]], "Input",
