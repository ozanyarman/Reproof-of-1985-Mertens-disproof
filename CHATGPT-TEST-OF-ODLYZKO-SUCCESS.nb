       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"frac", ",", "ry", ",", "pseudo"}], "}"}], ",", 
         RowBox[{
          RowBox[{"frac", "=", 
           RowBox[{
            RowBox[{"RandomInteger", "[", 
