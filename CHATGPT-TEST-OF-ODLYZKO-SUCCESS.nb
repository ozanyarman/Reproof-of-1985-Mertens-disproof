Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Title", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"ANDERSON", "-", 
    RowBox[{"STARK", " ", "STAGED"}], "+", 
    RowBox[{
     RowBox[{"/", 
      RowBox[{"-", "2"}]}], " ", "BARRIER", " ", "TEST"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
