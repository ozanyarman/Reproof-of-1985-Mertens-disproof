       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Log10", "[", "bestBase", "]"}], ",", "5"}], "]"}], "]"}], 
      ",", "\"\<) ...\>\""}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"controlResults", "=", 
     RowBox[{"Table", "[", 
