        RowBox[{"Min", "[", "valsCore", "]"}]}], ";", 
       RowBox[{"maxC", "=", 
        RowBox[{"Max", "[", "valsCore", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"normC", "=", 
        RowBox[{"If", "[", 
