          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fitStart", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"gridPeakIdx", "-", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fitEnd", "=", 
