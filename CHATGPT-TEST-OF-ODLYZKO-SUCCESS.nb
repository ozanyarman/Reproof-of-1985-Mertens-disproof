     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "scaled", ",", "fractionalDistances", ",", "minimumDistance", ",", 
         "scaledAccuracies", ",", "minimumScaledAccuracy", ",", 
         "estimatedUncertainty", ",", "stable"}], "}"}], ",", 
       RowBox[{
        RowBox[{"scaled", "=", 
         RowBox[{"N", "[", 
