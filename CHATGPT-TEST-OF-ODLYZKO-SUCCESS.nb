        ";", "\[IndentingNewLine]", 
        RowBox[{"leftBracket", "=", 
         RowBox[{"Missing", "[", "\"\<Failed\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
