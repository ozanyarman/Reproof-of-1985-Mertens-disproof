        "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{"Coefficient", "[", 
          RowBox[{"fit", ",", "x", ",", "2"}], "]"}]}], ";", 
        RowBox[{"b", "=", 
         RowBox[{"Coefficient", "[", 
