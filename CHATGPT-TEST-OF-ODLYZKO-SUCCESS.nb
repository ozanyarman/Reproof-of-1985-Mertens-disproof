            RowBox[{"k", "*", "0.001"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"valsFine", "=", 
         RowBox[{"evalU", "/@", "gridFine"}]}], ";", 
        RowBox[{"idxFine", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{"valsFine", ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gridUltra", "=", 
         RowBox[{
          RowBox[{"gridFine", "[", 
           RowBox[{"[", "idxFine", "]"}], "]"}], "+", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"k", "*", "0.0001"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"-", "150"}], ",", "150"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"valsUltra", "=", 
         RowBox[{"evalU", "/@", "gridUltra"}]}], ";", 
        RowBox[{"idxUltra", "=", 
         RowBox[{"First", "@", 
          RowBox[{"Ordering", "[", 
           RowBox[{"valsUltra", ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gridU", "=", "gridUltra"}], ";", 
        RowBox[{"values", "=", "valsUltra"}], ";", "\[IndentingNewLine]", 
        RowBox[{"gridPeakIdx", "=", 
