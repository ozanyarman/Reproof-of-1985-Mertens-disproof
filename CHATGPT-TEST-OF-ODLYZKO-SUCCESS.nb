         RowBox[{"-", "7"}]}]}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"201", " ", 
      RowBox[{"pts", ":", 
       RowBox[{"Core", " ", "wavepacket"}]}]}], "*)"}], 
    RowBox[{"uGridMeso", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "0.005"}], ",", "0.005", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}]}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"1001", " ", 
      RowBox[{"pts", ":", 
       RowBox[{"Mesoscopic", " ", "scale"}]}]}], "*)"}], 
    RowBox[{"uGridMacro", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "2.0"}], ",", "2.0", ",", "0.01"}], "]"}]}], ";", 
    RowBox[{"(*", 
     RowBox[{"401", " ", 
      RowBox[{"pts", ":", 
       RowBox[{"Macro", " ", "background"}]}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Optimized", " ", "Carrier"}], "-", 
      RowBox[{"Phase", " ", "Evaluator"}]}], "*)"}], 
    RowBox[{
     RowBox[{"evalFastGrid", "[", 
      RowBox[{"baseX_", ",", "prec_", ",", "uGrid_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zH", ",", "pH", ",", "aH", ",", "kH", ",", "wgt", ",", "phi0"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"zH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"zc4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"pc4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"aH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"ac4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kH", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{"kk4", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"wgt", "=", 
         RowBox[{"kH", "*", "aH"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"phi0", "=", 
         RowBox[{
          RowBox[{"zH", "*", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"baseX", ",", "prec"}], "]"}]}], "-", "pH"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ParallelMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"u", "=", 
               RowBox[{"SetPrecision", "[", 
                RowBox[{"#", ",", "prec"}], "]"}]}], "}"}], ",", 
             RowBox[{"2", "*", 
              RowBox[{"Total", "[", 
               RowBox[{"wgt", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{"phi0", "+", 
                  RowBox[{"zH", "*", "u"}]}], "]"}]}], "]"}]}]}], "]"}], 
           "&"}], ",", "uGrid"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"profilesUltra", "=", 
