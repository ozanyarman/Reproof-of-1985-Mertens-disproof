           RowBox[{"-", "minimumScaledAccuracy"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stable", "=", 
         RowBox[{"minimumDistance", ">", 
          RowBox[{"100", " ", "estimatedUncertainty"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
          "\"\<MinimumDistanceToInteger\>\"", "->", "minimumDistance"}], ",", 
          
          RowBox[{
          "\"\<MinimumScaledAccuracy\>\"", "->", "minimumScaledAccuracy"}], 
          ",", 
          RowBox[{
          "\"\<EstimatedUncertainty\>\"", "->", "estimatedUncertainty"}], ",", 
          RowBox[{"\"\<FloorStableHeuristically\>\"", "->", "stable"}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
