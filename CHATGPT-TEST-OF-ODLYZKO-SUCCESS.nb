     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"orthogonal", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"squaredNorms", "=", 
          RowBox[{"{", "}"}]}], ",", "vector", ",", "projection", ",", "i", 
         ",", "j"}], "}"}], ",", 
       RowBox[{
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "basis", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{
           RowBox[{"vector", "=", 
            RowBox[{"basis", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "orthogonal", "]"}]}], ",", 
             RowBox[{"j", "++"}], ",", 
             RowBox[{
              RowBox[{"projection", "=", 
               RowBox[{"Cancel", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"vector", ".", 
                   RowBox[{"orthogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
                 RowBox[{"squaredNorms", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"vector", "=", 
               RowBox[{"Together", "[", 
                RowBox[{"vector", "-", 
                 RowBox[{"projection", " ", 
                  RowBox[{"orthogonal", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}], ";"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"orthogonal", ",", "vector"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"squaredNorms", ",", 
             RowBox[{"Together", "[", 
              RowBox[{"vector", ".", "vector"}], "]"}]}], "]"}], ";"}]}], 
