           RowBox[{
            RowBox[{"(", 
             RowBox[{"stepMeso", "/", "fwhm"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"0.5", "*", 
               RowBox[{"normM", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "+", 
              RowBox[{"0.5", "*", 
               RowBox[{"normM", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}]}], "+", 
              RowBox[{"Total", "[", 
               RowBox[{"normM", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;", 
