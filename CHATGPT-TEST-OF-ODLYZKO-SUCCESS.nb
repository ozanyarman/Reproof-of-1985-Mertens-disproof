          RowBox[{"FWHM", "--"}]}], "-"}], "*)"}], 
       RowBox[{"valsMeso", "=", 
        RowBox[{"evalFastGrid", "[", 
         RowBox[{"baseX", ",", "prec", ",", "uGridMeso"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
