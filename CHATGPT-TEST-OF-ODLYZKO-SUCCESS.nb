         ",", "theoreticalCeiling"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"L", ">=", "availableTerms"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Cutoff L = \>\"", ",", "L", ",", 
             "\"\< skipped because the next zero is unavailable.\>\""}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"{", "}"}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Choose", " ", "T", " ", "strictly", " ", "between", " ", "gamma_L", 
          " ", "and", " ", "gamma_", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"L", "+", "1"}], ")"}], ".", "Hence"}], " ", "Gamma", " ", 
          RowBox[{"intersection", "[", 
           RowBox[{"0", ",", "T"}], "]"}], " ", "consists", " ", "exactly", 
          " ", "of", " ", "the", " ", "first", " ", "L", " ", "positive", " ", 
          RowBox[{"ordinates", "."}]}], "*)"}], 
        RowBox[{"T", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"zeros", "[", 
               RowBox[{"[", "L", "]"}], "]"}], "+", 
              RowBox[{"zeros", "[", 
               RowBox[{"[", 
                RowBox[{"L", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], 
           ",", "workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"localZeros", "=", 
         RowBox[{"zeros", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "L"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"localAlphas", "=", 
         RowBox[{"alphas", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "L"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kernelWeights", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"kernelFunction", "/@", 
            RowBox[{"(", 
             RowBox[{"localZeros", "/", "T"}], ")"}]}], ",", 
           "workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"contributions", "=", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"localAlphas", "*", "kernelWeights"}], ",", 
           "workingPrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Sort", " ", "from", " ", "heaviest", " ", "to", " ", "lightest", 
          " ", 
          RowBox[{"contribution", "."}]}], "*)"}], 
        RowBox[{"ranking", "=", 
         RowBox[{"Reverse", "@", 
          RowBox[{"Ordering", "[", "contributions", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sortedIndices", "=", "ranking"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sortedContributions", "=", 
         RowBox[{"contributions", "[", 
          RowBox[{"[", "ranking", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"cumulativeSums", "=", 
         RowBox[{"Accumulate", "[", "sortedContributions", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nLimit", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"maximumSelected", ",", "L"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"rawSum", "=", 
             RowBox[{"cumulativeSums", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"requiredN", "=", 
             RowBox[{"requiredUniformN", "[", 
              RowBox[{"rawSum", ",", "targetBarrier"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"attainedBound", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"requiredN", "===", "Infinity"}], ",", 
               RowBox[{"2", " ", "rawSum"}], ",", 
               RowBox[{"boundScore", "[", 
                RowBox[{"rawSum", ",", "requiredN"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"theoreticalCeiling", "=", 
