                RowBox[{
                 RowBox[{"interp", "[", "x", "]"}], "==", "halfMax"}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", 
                  RowBox[{"rightBracket", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"rightBracket", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
              RowBox[{"Missing", "[", "\"\<Failed\>\"", "]"}]}], "]"}]}], ",", 
           RowBox[{"Missing", "[", "\"\<Failed\>\"", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rightFWHM", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"MissingQ", "[", "rightRoot", "]"}]}], "&&", 
            RowBox[{
             RowBox[{"(", 
