Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Title", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"ANDERSON", "-", "STARK", "+", 
    RowBox[{
     RowBox[{"/", 
      RowBox[{"-", "2"}]}], " ", "PROOF"}], "-", 
    RowBox[{"ORIENTED", " ", "CERTIFICATION", " ", "STAGE"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Run", " ", "this", " ", "block", " ", "AFTER", " ", "the", " ", 
    "reconnaissance", " ", 
    RowBox[{"scanner", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<==============================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\< ANDERSON-STARK PROOF-ORIENTED CERTIFICATION STAGE\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<==============================================================\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"0.", " ", "User", " ", "configuration"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetBarrier", "=", "2"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Prefer", " ", "a", " ", "visible", " ", "margin"}], ",", 
     RowBox[{
      RowBox[{"not", " ", "merely", " ", "2.000000"}], "..."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"desiredSafetyMargin", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "3"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Maximum", " ", "acceptable", " ", "uniform", " ", "independence", " ", 
     "requirement", " ", "when", " ", "searching", " ", "for", " ", "a", " ", 
     "practical", " ", 
     RowBox[{"candidate", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maximumPreferredNgamma", "=", 
     RowBox[{"10", "^", "6"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Decimal", " ", "scaling", " ", "exponent", " ", "K"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"10", "^", "k"}], " ", "used", " ", "in", " ", "the", " ", 
        "relation", " ", 
        RowBox[{"lattice", ".", "With"}], " ", "approximately", " ", "250"}], 
       "-", 
       RowBox[{"digit", " ", "input", " ", "data"}]}]}], ",", 
     RowBox[{
     "do", " ", "not", " ", "use", " ", "k", " ", "near", " ", "250.", " ", 
      "Retain", " ", "a", " ", "substantial", " ", "accuracy", " ", 
      RowBox[{"guard", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"requestedKDigits", "=", "180"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"accuracyGuardDigits", "=", "30"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Certification", " ", 
      RowBox[{"modes", ":", "\"\<Pilot\>\"", ":", 
       RowBox[{"High", "-", 
        RowBox[{"precision", " ", "numerical", " ", "Gram"}], "-", 
        RowBox[{
         RowBox[{"Schmidt", ".", "Useful"}], " ", "for", " ", 
         "screening"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"but", " ", "not", " ", "a", " ", "rigorous", " ", 
       RowBox[{"proof", ".", "\"\<Exact\>\""}]}], ":", 
      RowBox[{
       RowBox[{"Exact", " ", "rational", " ", "Gram"}], "-", 
       RowBox[{
       "Schmidt", " ", "on", " ", "the", " ", "integer", " ", "LLL", " ", 
        RowBox[{"output", ".", "Potentially"}], " ", "extremely", " ", 
        "expensive", " ", "in", " ", "high", " ", 
        RowBox[{"dimension", "."}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"certificationMode", "=", "\"\<Pilot\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Set", " ", "True", " ", "only", " ", "after", " ", "a", " ", "candidate",
