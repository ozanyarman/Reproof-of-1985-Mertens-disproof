                  RowBox[{"\"\<ZeroIndex\>\"", "->", "ambientIndex"}], ",", 
                  RowBox[{"\"\<Status\>\"", "->", "status"}]}], "|>"}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"basis", "=", 
            RowBox[{"RelationLatticeBasis", "[", 
             RowBox[{"augmentedZeros", ",", "scale"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"timing", "=", 
