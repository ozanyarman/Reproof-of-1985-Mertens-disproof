   RowBox[{
    RowBox[{"ClearAll", "[", "LargestCertifiedBaseN", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LargestCertifiedBaseN", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"gsMinimum_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "root", ",", "candidate"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"gsMinimum", "<=", "2"}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{
          RowBox[{"n", "^", "2"}], "+", "n"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"b", "=", 
         RowBox[{
          RowBox[{"2", " ", "n"}], "+", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"root", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "b"}], "+", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"b", "^", "2"}], "+", 
              RowBox[{"4", " ", "a", " ", 
               RowBox[{"(", 
                RowBox[{"gsMinimum", "-", "2"}], ")"}]}]}], "]"}]}], ")"}], 
          "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "a"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"candidate", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Ceiling", "[", "root", "]"}], "-", "1"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"candidate", ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"BaseThreshold", "[", 
             RowBox[{"n", ",", "candidate"}], "]"}], ">=", "gsMinimum"}]}], 
          ",", 
          RowBox[{"candidate", "--"}]}], "]"}], ";", "\[IndentingNewLine]", 
        "candidate"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "LargestCertifiedAugmentedN", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LargestCertifiedAugmentedN", "[", 
      RowBox[{"n_Integer", ",", 
