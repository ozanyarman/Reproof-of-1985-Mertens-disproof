   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "gramSchmidtMinSquaredNumeric", ",", "gramSchmidtMinSquaredExact"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"gramSchmidtMinSquaredNumeric", "[", 
      RowBox[{"basis_List", ",", 
       RowBox[{"precision_Integer", ":", "150"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "b", ",", "orthogonal", ",", "squaredNorms", ",", "v", ",", 
         "projection", ",", "i", ",", "j"}], "}"}], ",", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"N", "[", 
          RowBox[{"basis", ",", "precision"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"orthogonal", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"squaredNorms", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", 
           RowBox[{"Length", "[", "b", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{
           RowBox[{"v", "=", 
            RowBox[{"b", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "orthogonal", "]"}]}], ",", 
             RowBox[{"j", "++"}], ",", 
             RowBox[{
              RowBox[{"projection", "=", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"v", ".", 
                  RowBox[{"orthogonal", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", 
                RowBox[{"squaredNorms", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"v", "=", 
               RowBox[{"v", "-", 
                RowBox[{"projection", " ", 
                 RowBox[{"orthogonal", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}]}]}], ";"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"orthogonal", ",", "v"}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"squaredNorms", ",", 
