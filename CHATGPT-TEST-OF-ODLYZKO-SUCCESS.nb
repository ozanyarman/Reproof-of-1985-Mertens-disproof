          RowBox[{"scaleKernelWithNMax", ",", 
           RowBox[{"zeros", "[", 
            RowBox[{"[", "nMaxCurrent", "]"}], "]"}], ",", "Tfixed"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kk", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"t", "=", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"zc", "[", 
