   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ScalingAudit", "[", 
      RowBox[{"ordinates_List", ",", "scale_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "scaled", ",", "distances", ",", "minimumDistance", ",", 
         "minimumAccuracy", ",", "uncertainty", ",", "stable"}], "}"}], ",", 
       RowBox[{
        RowBox[{"scaled", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"scale", " ", "ordinates"}], ",", "inputPrecision"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"distances", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{"FractionalPart", "[", "z", "]"}], ",", 
               RowBox[{"1", "-", 
                RowBox[{"FractionalPart", "[", "z", "]"}]}]}], "]"}]}], "]"}],
            ",", "scaled"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"minimumDistance", "=", 
         RowBox[{"Min", "[", "distances", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"minimumAccuracy", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"Accuracy", "/@", "scaled"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"uncertainty", "=", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "minimumAccuracy"}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stable", "=", 
         RowBox[{"minimumDistance", ">", 
          RowBox[{"100", " ", "uncertainty"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{
          "\"\<MinimumDistanceToInteger\>\"", "->", "minimumDistance"}], ",", 
          
          RowBox[{"\"\<MinimumScaledAccuracy\>\"", "->", "minimumAccuracy"}], 
          ",", 
          RowBox[{"\"\<EstimatedUncertainty\>\"", "->", "uncertainty"}], ",", 
          
          RowBox[{"\"\<Stable\>\"", "->", "stable"}]}], "|>"}]}]}], "]"}]}], 
