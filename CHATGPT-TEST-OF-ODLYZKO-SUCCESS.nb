Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"PHASE", " ", "4.5"}], ":", 
      RowBox[{"MONTE", " ", "CARLO", " ", "NULL", " ", "MODEL"}]}], "&"}], 
    " ", "CLUSTER", " ", "DIAGNOSTIC"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n=== PHASE 4.5: MONTE CARLO NULL-MODEL & CLUSTERING ===\>\"", 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "1.", " ", "Monte", " ", "Carlo", " ", "Null", " ", "Model", " ", "for", 
      " ", "20"}], "-", 
     RowBox[{"Mode", " ", "Weighted", " ", "Phase", " ", "Coherence"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nTrials", "=", "50000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nModes", "=", "20"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "empirical", " ", "random", " ", "weights", " ", 
     "similar", " ", "to", " ", "top", " ", "20", " ", "zeta", " ", 
     "amplitudes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"top20Weights", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"1.0", "/", 
        RowBox[{"Sqrt", "[", "k", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "nModes"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"normWeights", "=", 
     RowBox[{"top20Weights", "/", 
      RowBox[{"Total", "[", "top20Weights", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Simulating null distribution for R_weighted (50,000 trials)...\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nullR", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"randPhases", "=", 
         RowBox[{"RandomReal", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", "nModes"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Abs", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"normWeights", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", "*", "randPhases"}], "]"}]}], "]"}], "]"}]}], ",", 
       RowBox[{"{", "nTrials", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"nullMean", "=", 
     RowBox[{"Mean", "[", "nullR", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nullP95", "=", 
     RowBox[{"Quantile", "[", 
      RowBox[{"nullR", ",", "0.95"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nullP99", "=", 
     RowBox[{"Quantile", "[", 
      RowBox[{"nullR", ",", "0.99"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Null Model Baseline:\>\"", "]"}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Mean R: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"nullMean", ",", "4"}], "]"}], ",", 
      "\"\< | 95th Percentile: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"nullP95", ",", "4"}], "]"}], ",", 
      "\"\< | 99th Percentile: \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"nullP99", ",", "4"}], "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Compute", " ", "p"}], "-", 
     RowBox[{
     "values", " ", "for", " ", "actual", " ", "candidate", " ", "R", " ", 
      "values"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pValuesTable", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vVal", "=", 
         RowBox[{"phaseCoherence", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "\"\<v\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rVal", "=", 
         RowBox[{"phaseCoherence", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "\"\<R\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pVal", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Select", "[", 
              RowBox[{"nullR", ",", 
               RowBox[{
                RowBox[{"#", ">=", "rVal"}], "&"}]}], "]"}], "]"}], "/", 
            "nTrials"}], ",", "5"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<v=\>\"", "<>", 
           RowBox[{"ToString", "[", "vVal", "]"}]}], ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"rVal", ",", "4"}], "]"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"pVal", "==", "0"}], ",", "\"\<< 0.00002\>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"pVal", ",", "5"}], "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "phaseCoherence", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nPhase Coherence Statistical Significance:\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{"pValuesTable", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Candidate\>\"", ",", "\"\<Observed R_weighted\>\"", ",", 
           "\"\<Null Model p-value\>\""}], "}"}]}], "]"}], ",", 
       RowBox[{"Frame", "->", "All"}]}], "]"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Hierarchical", " ", "Clustering", " ", "on", " ", "Spectral", 
     " ", "RMS", " ", "Matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== SPECTRAL SUB-FAMILY CLUSTERING ===\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"clusters", "=", 
     RowBox[{"ClusterDissimilarity", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"spectraCore", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "\"\<spec\>\""}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "spectraCore", "]"}]}], "}"}]}], "]"}], ",",
        "EuclideanDistance"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<Detected Spectral Distance Structure among Top Candidates.\>\"", 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.993694260925826*^9, 3.993694260953676*^9}},
