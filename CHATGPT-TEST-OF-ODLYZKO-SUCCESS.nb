              RowBox[{"reduced", "=", 
               RowBox[{"LatticeReduce", "[", "basis", "]"}]}], ";"}], "]"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"qrAudit", "=", 
            RowBox[{"StableQRAudit", "[", 
             RowBox[{"reduced", ",", "kDigits"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
