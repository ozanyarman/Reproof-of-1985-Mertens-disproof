           RowBox[{"cand", "[", "\"\<survivingDigits\>\"", "]"}]}], ",", 
          RowBox[{"\"\<baseCoord\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cand", "[", "\"\<baseCoord\>\"", "]"}], ",", "20"}], 
            "]"}]}], ",", 
          RowBox[{"\"\<peakX\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"exactPeakX", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<baselineDiscovery\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cand", "[", "\"\<baselineDiscovery\>\"", "]"}], ",", 
             "20"}], "]"}]}], ",", 
          RowBox[{"\"\<baselineCurrent\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"baselineCurrent", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<Delta_Baseline\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"deltaBaseline", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<peakY\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"exactPeakY", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<troughVal\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"troughVal", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<FWHM\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"continuousFWHM", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<curvature\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"exactCurvature", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<Invariant_Q\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"Q", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<CosineMean\>\"", "->", 
           RowBox[{"N", "[", 
            RowBox[{"cosMean", ",", "20"}], "]"}]}], ",", 
          RowBox[{"\"\<Cos99\>\"", "->", "cos99"}]}], "|>"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"nMaxValues", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "2000", ",", "5000", ",", "10000", ",", "50000", ",", "100000"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"#", "<=", "availableTerms"}], "&"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<nMax sweep: \>\"", ",", "nMaxValues", ",", 
      "\"\<  (WARNING: nMax=100000 at 250 digits is expensive)\>\""}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"finalResults", "=", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
          "Print", "[", 
           "\"\<\\n------------------------------------------\>\"", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<RUNNING nMax = \>\"", ",", "nMaxVal"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"kernelData", "=", 
           RowBox[{"buildKernelData", "[", "nMaxVal", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Sow", "[", 
             RowBox[{"evaluateCandidate", "[", 
              RowBox[{"c", ",", "kernelData", ",", "nMaxVal"}], "]"}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", "trustedCandidates"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"nMaxVal", ",", "nMaxValues"}], "}"}]}], "]"}], "]"}], "[", 
      
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nDONE. finalResults has \>\"", ",", 
      RowBox[{"Length", "[", "finalResults", "]"}], ",", "\"\< rows.\>\""}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "=="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"PHASE", " ", "3"}], ":", 
     RowBox[{
     "RANDOM", " ", "CONTROL", " ", "on", " ", "the", " ", "best", " ", 
      "candidate"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n=== PHASE 3: RANDOM CONTROL (falsification test) ===\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"maxN", "=", 
     RowBox[{"Max", "[", "nMaxValues", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finalAtMaxN", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"finalResults", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<sampleSize\>\"", "]"}], "==", "maxN"}], 
        "&"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bestRow", "=", 
     RowBox[{"First", "@", 
      RowBox[{"SortBy", "[", 
       RowBox[{"finalAtMaxN", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"#", "[", "\"\<peakY\>\"", "]"}]}], "&"}]}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"bestCand", "=", 
