              RowBox[{"b", "^", "2"}], "+", 
              RowBox[{"4", " ", "a", " ", 
               RowBox[{"(", 
                RowBox[{"gsMinimum", "-", "2"}], ")"}]}]}], "]"}]}], ")"}], 
          "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "a"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"candidate", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0", ",", 
           RowBox[{
            RowBox[{"Ceiling", "[", "root", "]"}], "-", "1"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"candidate", ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"AugmentedThreshold", "[", 
             RowBox[{"n", ",", "candidate"}], "]"}], ">=", "gsMinimum"}]}], 
          ",", 
          RowBox[{"candidate", "--"}]}], "]"}], ";", "\[IndentingNewLine]", 
        "candidate"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
