        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", 
        "\"\<If the required independence is certified, then:\>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<limsup M(x)/Sqrt[x] >= \>\"", ",", 
         RowBox[{"bestCandidate", "[", "\"\<BoundAtRequiredN\>\"", "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<liminf M(x)/Sqrt[x] <= -\>\"", ",", 
         RowBox[{"bestCandidate", "[", "\"\<BoundAtRequiredN\>\"", "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"bestCandidateDataset", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Rank\>\"", "->", "rank"}], ",", 
            RowBox[{"\"\<OriginalZeroIndex\>\"", "->", 
             RowBox[{"bestSelectedIndices", "[", 
              RowBox[{"[", "rank", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Gamma\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"bestSelectedZeros", "[", 
                RowBox[{"[", "rank", "]"}], "]"}], ",", "50"}], "]"}]}], ",", 
            
            RowBox[{"\"\<Alpha\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"bestSelectedAlphas", "[", 
                RowBox[{"[", "rank", "]"}], "]"}], ",", "50"}], "]"}]}], ",", 
            
            RowBox[{"\"\<KernelWeight\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"bestKernelWeights", "[", 
                RowBox[{"[", 
                 RowBox[{"bestSelectedIndices", "[", 
                  RowBox[{"[", "rank", "]"}], "]"}], "]"}], "]"}], ",", 
               "50"}], "]"}]}], ",", 
            RowBox[{"\"\<WeightedContribution\>\"", "->", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"bestSelectedContributions", "[", 
                RowBox[{"[", "rank", "]"}], "]"}], ",", "50"}], "]"}]}]}], 
           "|>"}], ",", 
          RowBox[{"{", 
           RowBox[{"rank", ",", "1", ",", "bestNSelected"}], "}"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
        "\"\<Anderson_Stark_Best_Candidate_Selected_Zeros.csv\>\"", ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"Values", "/@", "bestCandidateDataset"}], ",", 
           RowBox[{"Keys", "[", 
            RowBox[{"First", "[", "bestCandidateDataset", "]"}], "]"}]}], 
          "]"}], ",", "\"\<CSV\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{"\"\<Anderson_Stark_Best_Candidate.mx\>\"", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<CandidateSummary\>\"", "->", "bestCandidate"}], ",", 
           RowBox[{"\"\<CutoffT\>\"", "->", "bestT"}], ",", 
           RowBox[{"\"\<SelectedIndices\>\"", "->", "bestSelectedIndices"}], 
           ",", 
           RowBox[{"\"\<SelectedZeros\>\"", "->", "bestSelectedZeros"}], ",", 
           
           RowBox[{"\"\<SelectedAlphas\>\"", "->", "bestSelectedAlphas"}], 
           ",", 
           RowBox[{
           "\"\<SelectedContributions\>\"", "->", 
            "bestSelectedContributions"}]}], "|>"}]}], "]"}], ";"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
